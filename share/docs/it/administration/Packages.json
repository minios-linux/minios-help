          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-store-gui"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-image-builder"
            ]
          ]
        ],
        [
          "text",
