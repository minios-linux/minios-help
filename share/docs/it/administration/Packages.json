              "smartmontools"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "dosfstools"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
