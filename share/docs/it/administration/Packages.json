              "genisoimage"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "In Xfce, Standard e le edizioni successive aggiungono le utility grafiche e amministrative MiniOS attuali: "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-configurator"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-installer"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-session-manager"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
