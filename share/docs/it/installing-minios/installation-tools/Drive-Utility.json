          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "/dev/sdX",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "heading",
      2,
      "crea-unimmagine-del-dispositivo",
      [
        [
          "text",
          "Crea un'immagine del dispositivo"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Crea immagine"
            ]
          ]
        ],
        [
          "text",
          " legge un dispositivo fisico e lo salva in un file immagine. Il file risultante può restare raw oppure essere compresso durante la scrittura."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Le opzioni di compressione supportate sono:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "gzip ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      ".gz"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "bzip2 ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      ".bz2"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "XZ ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      ".xz"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "LZ4 ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      ".lz4"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Zstandard ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      ".zst"
                    ]
                  ]
                ],
                [
                  "text",
                  ") quando è installato il supporto Python zstd richiesto"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "L'applicazione grafica può anche assegnare il file risultante all'utente desktop, così un backup creato da root è subito utilizzabile senza dover correggere i permessi."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Esempio CLI:"
        ]
      ]
    ],
    [
      "code_block",
      "sudo driveutility-read -s /dev/sdX -t /path/to/backup.img -c zstd",
      "bash",
      [
        [
          "syntax",
          "sudo",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
