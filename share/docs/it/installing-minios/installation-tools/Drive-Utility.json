          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "-s",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "/path/to/minios.iso",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "-t",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
