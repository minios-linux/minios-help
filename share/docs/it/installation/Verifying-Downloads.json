      "heading",
      1,
      "verifica-dei-download",
      [
        [
          "text",
          "Verifica dei download"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Le release di MiniOS sono pubblicate sulla "
        ],
        [
          "link",
          "https://github.com/minios-linux/minios-live/releases",
          null,
          [
            [
              "text",
              "pagina ufficiale dei rilasci GitHub"
            ]
          ]
        ],
        [
          "text",
          ". Ogni asset ISO della release ha un file corrispondente il cui nome termina con "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".iso.sha256"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "La verifica SHA-256 rileva un download incompleto o alterato. Non prova chi ha creato i file. La release attualmente fornisce checksum, non file di firma crittografica, quindi questa pagina non descrive la verifica delle firme."
        ]
      ]
    ],
    [
      "heading",
      2,
      "scarica-entrambi-i-file",
      [
        [
          "text",
          "Scarica entrambi i file"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Scarica l'ISO e il relativo file "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sha256"
            ]
          ]
        ],
        [
          "text",
          " dalla stessa release su GitHub. Mantieni entrambi i file nella stessa cartella. I loro nomi base devono corrispondere, ad esempio:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-trixie-xfce-standard-amd64-5.1.1.iso\nminios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Usa i nomi della release che hai scaricato nei comandi qui sotto."
        ]
      ]
    ],
    [
      "heading",
