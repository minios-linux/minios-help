      [
        [
          "text",
          "Linux"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Apri un terminale nella cartella di download ed esegui:"
        ]
      ]
    ],
    [
      "code_block",
      "sha256sum --check minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "bash",
      [
        [
          "syntax",
          "sha256sum",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "--check",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Un download valido riporta il nome dell'ISO seguito da "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "OK"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
