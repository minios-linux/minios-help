                  [
                    [
                      "text",
                      "File system"
                    ]
                  ]
                ],
                [
                  "text",
                  ": FAT32, NTFS, ext2/3/4, Btrfs"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Schema di partizionamento"
                    ]
                  ]
                ],
                [
                  "text",
                  ": MBR"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Avvio EFI"
                    ]
                  ]
                ],
                [
                  "text",
                  ": Se si utilizzano file system NTFS, exFAT o ext2/3/4, l’avvio in modalità EFI potrebbe non essere disponibile. Per il supporto EFI, si consiglia FAT32."
                ]
              ]
            ]
