          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Seleziona una sessione nuova per un test iniziale dell’hardware, oppure una sessione persistente solo se è già stata configurata."
