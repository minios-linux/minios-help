  "nodes": [
    [
      "heading",
      1,
      "rilevamento-del-sistema-initrd",
      [
        [
          "text",
          "Rilevamento del sistema Initrd"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Dopo che il bootloader ha caricato il kernel e l'initramfs, l'initramfs deve individuare"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "l'albero dati di MiniOS che fornisce i moduli di sistema "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sb"
            ]
          ]
        ],
        [
          "text",
          ". Questo avviene prima"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "che siano attivi lo stack di rete userspace, il desktop e la sessione persistente."
        ]
      ]
    ],
    [
      "heading",
      2,
      "precedenza-delle-sorgenti",
      [
        [
          "text",
          "Precedenza delle sorgenti"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "La selezione della sorgente segue una precedenza fissa:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Un valore letterale "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=http://..."
                    ]
                  ]
                ],
                [
                  "text",
                  " seleziona un ISO HTTP."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "In caso contrario, qualsiasi valore "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " non vuoto seleziona il download PXE."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Altrimenti, "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=askdisk"
                    ]
                  ]
                ],
                [
                  "text",
                  " o "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=askdisk:..."
                    ]
                  ]
                ],
                [
                  "text",
                  " apre il selettore disco."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Se nessuna delle precedenti, l'initramfs esegue una scansione dei dispositivi di blocco locali."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "I due percorsi di rete non effettuano il fallback su supporti locali. Dopo un tentativo HTTP ISO o PXE,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "il rilevamento restituisce quel risultato di rete invece di provare i dischi; un"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "risultato inutilizzabile o incompleto non supera la validazione o la configurazione successiva."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Questo ordine ha due conseguenze importanti:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=http://..."
                    ]
                  ]
                ],
                [
                  "text",
                  " ha la precedenza su "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  ". L'opzionale "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " fornisce quindi"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "l'indirizzamento statico per la connessione HTTP ISO."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Un valore "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " non vuoto prevale su qualsiasi valore locale "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from="
                    ]
                  ]
                ],
                [
                  "text",
                  ", inclusi un dispositivo,"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "una directory, un percorso ISO o "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "askdisk"
                    ]
                  ]
                ],
                [
                  "text",
                  ". Non utilizzare "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " solo per configurare la"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "rete di un sistema avviato localmente."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "heading",
      2,
      "rilevamento-locale",
      [
        [
          "text",
          "Rilevamento locale"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "In assenza di una sorgente HTTP o di un "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          " non vuoto, MiniOS effettua 45 passaggi di rilevamento,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "approssimativamente uno al secondo. Ogni passaggio aggiorna i nodi dei dispositivi, ottiene i candidati"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "dispositivo di blocco da "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "blkid"
            ]
          ]
        ],
        [
          "text",
          ", ordina i loro nomi e li testa in quell'ordine. Il primo candidato che contiene una sorgente MiniOS valida viene mantenuto;"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "i dispositivi successivi non vengono considerati."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Se "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from="
            ]
          ]
        ],
        [
          "text",
          " è vuoto, il percorso testato su ogni filesystem è "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          ". Una sorgente è valida quando quella directory o la sua sottodirectory"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "modules/"
            ]
          ]
        ],
        [
          "text",
          " immediata contiene almeno un file con estensione "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sb"
            ]
          ]
        ],
        [
          "text",
          " (impostazione predefinita). Il parametro "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "bext="
            ]
          ]
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "modifica l'estensione utilizzata da questo test. Il rilevamento non verifica che"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "l'insieme di moduli trovato sia completo o avviabile."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Ogni candidato viene inizialmente montato in sola lettura. Dopo la validazione, MiniOS tenta"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "di rendere scrivibile il mount selezionato, ma l'impossibilità di farlo non"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "esclude una sorgente altrimenti valida."
        ]
      ]
    ],
    [
      "heading",
      3,
      "formati-locali-di-from",
      [
        [
          "text",
          "Formati locali di "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from="
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Un percorso relativo o assoluto viene interpretato all'interno di ogni filesystem candidato. Gli slash iniziali vengono normalizzati durante la costruzione del percorso, quindi"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "entrambi cercano la stessa directory:"
        ]
      ]
    ],
    [
      "code_block",
      "from=minios\nfrom=/minios",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Se il percorso richiesto è un file regolare su un filesystem candidato, MiniOS"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "lo tratta come un ISO, lo monta in loop in sola lettura e testa la directory "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "all'interno dell'ISO:"
        ]
      ]
    ],
    [
      "code_block",
      "from=/images/minios.iso",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "I percorsi qualificati dal dispositivo supportano solo queste forme:"
        ]
      ]
    ],
    [
      "code_block",
      "from=/dev/sdb1/minios\nfrom=/dev/sr0/minios\nfrom=/dev/disk/by-label/MINIOS/minios",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "/dev/<name>/path"
            ]
          ]
        ],
        [
          "text",
          " supporta un semplice nome dispositivo seguito da un percorso. La forma con etichetta"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "deve essere esattamente "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/dev/disk/by-label/LABEL/path"
            ]
          ]
        ],
        [
          "text",
          "; l'etichetta viene risolta con"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "blkid"
            ]
          ]
        ],
        [
          "text",
          ", quindi il percorso rimanente viene testato su quel filesystem."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Non esiste un parser corrispondente per i percorsi UUID, PARTUUID o by-id. Forme come"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "le seguenti non sono supportate:"
        ]
      ]
    ],
    [
      "code_block",
      "from=/dev/disk/by-uuid/UUID/minios\nfrom=/dev/disk/by-partuuid/PARTUUID/minios\nfrom=/dev/disk/by-id/ID/minios",
      "",
      []
    ],
    [
      "heading",
      3,
      "selezione-interattiva",
      [
        [
          "text",
          "Selezione interattiva"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Usa "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "askdisk"
            ]
          ]
        ],
        [
          "text",
          " per selezionare una partizione e poi testare un percorso su di essa:"
        ]
      ]
    ],
    [
      "code_block",
      "from=askdisk\nfrom=askdisk:custom:dir",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "La prima forma testa "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          " sulla partizione selezionata. Nella seconda forma,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "i due punti diventano separatori di percorso, quindi "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "askdisk:custom:dir"
            ]
          ]
        ],
        [
          "text",
          " testa "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "custom/dir"
            ]
          ]
        ],
        [
          "text",
          "."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "La sintassi con slash come "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from=askdisk/custom/dir"
            ]
          ]
        ],
        [
          "text",
          " apre comunque il selettore ma"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "perde silenziosamente il percorso personalizzato e testa "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          "; non usarla."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "L'elenco dei dispositivi visualizzato viene aggiornato mentre il selettore è aperto ed esclude"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "i filesystem di swap. La selezione esegue comunque il normale test di presenza dei moduli;"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "la sola scelta della partizione non è sufficiente."
        ]
      ]
    ],
    [
      "heading",
      2,
      "http-iso",
      [
        [
          "text",
          "HTTP ISO"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Una sorgente HTTP ISO ha questa forma:"
        ]
      ]
    ],
    [
      "code_block",
      "from=http://server.example/path/minios.iso",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Viene riconosciuto solo HTTP semplice. HTTPS e altri schemi URL non sono supportati."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "L'initramfs individua la prima interfaccia di rete non loopback rilevata, attiva la rete"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "e monta l'ISO remoto tramite "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "httpfs2"
            ]
          ]
        ],
        [
          "text",
          ". La selezione dell'interfaccia"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "non verifica la presenza di collegamento, la raggiungibilità o se quella interfaccia sia quella utilizzabile"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "su un sistema con più NIC."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Quando "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          " è assente, l'avvio HTTP ISO richiede DHCP con "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "udhcpc"
            ]
          ]
        ],
        [
          "text",
          ". Quando "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "è presente, utilizza i campi statici previsti dal parser PXE:"
        ]
      ]
    ],
    [
      "code_block",
      "ip=<client-ip>:<server-ip>:<gateway-ip>:<netmask>[:<port>]",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Per l'avvio HTTP ISO, l'URL determina comunque il server HTTP. I campi statici"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "configurano l'indirizzo client, la netmask, il gateway predefinito e le prime voci DNS;"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "il campo porta opzionale appartiene al download file PXE e non sostituisce la porta nell'URL ISO."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "cache=<MB>"
            ]
          ]
        ],
        [
          "text",
          " abilita una cache httpfs della dimensione richiesta in "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/tmp"
            ]
          ]
        ],
        [
          "text",
          ". Si tratta di"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "una cache, non di un download completo garantito. Il sistema in esecuzione continua a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "dipendere dall'ISO remoto e dalla rete a meno che una copia su RAM non riesca a staccare la sorgente."
        ]
      ]
    ],
    [
      "heading",
      2,
      "download-dati-pxe",
      [
        [
          "text",
          "Download dati PXE"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Qualsiasi "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          " non vuoto seleziona il download dati PXE a meno che non sia stato"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "selezionato prima "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from=http://..."
            ]
          ]
        ],
        [
          "text",
          ". La sintassi supportata è:"
        ]
      ]
    ],
    [
      "code_block",
      "ip=<client-ip>:<server-ip>:<gateway-ip>:<netmask>[:<port>]",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "La netmask è in notazione IPv4 puntata. La porta HTTP opzionale predefinita è "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "7529"
            ]
