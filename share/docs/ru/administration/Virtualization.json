                  [
                    [
                      "text",
                      "Отключить автонастройку:"
                    ]
                  ]
                ],
                [
                  "text",
                  " параметр ядра "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "novirtres"
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
