    [
      "heading",
      1,
      "руководство-по-виртуализации-minios",
      [
        [
          "text",
          "Руководство по виртуализации MiniOS"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "В этом руководстве описывается запуск MiniOS в виртуальных машинах, оптимизация производительности и использование MiniOS в качестве хоста виртуализации. MiniOS основан на Debian 13 \"Trixie\" и включает встроенные драйверы виртуализации и гостевые утилиты для максимальной производительности."
        ]
      ]
    ],
    [
      "heading",
      2,
      "особенности-виртуализации-в-minios",
      [
        [
          "text",
          "Особенности виртуализации в MiniOS"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS включает встроенную поддержку обнаружения виртуализации и автоматической настройки разрешения экрана. В системе есть скрипт "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-virtreschange"
            ]
          ]
        ],
        [
          "text",
          ", который автоматически определяет виртуальные среды (VirtualBox, VMware, KVM, QEMU, Xen, Hyper-V) и настраивает разрешение экрана соответствующим образом."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Автоматическое управление разрешением:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Параметр ядра:"
                    ]
                  ]
                ],
                [
                  "text",
                  " "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "virtres=ШИРИНAxВЫСОТА"
                    ]
                  ]
                ],
                [
                  "text",
                  " (например, "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "virtres=1920x1080"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
