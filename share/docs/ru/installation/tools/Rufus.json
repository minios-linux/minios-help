              "text",
              "Режимы загрузки"
            ]
          ]
        ],
        [
          "text",
          " и "
        ],
        [
          "link",
          "/configuration/Initrd-Persistence.md",
          null,
          [
            [
              "text",
              "Персистентность Initrd"
            ]
          ]
        ],
