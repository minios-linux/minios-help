      ]
    ],
    [
      "heading",
      3,
      "шаг-1-подготовка-накопителя",
      [
        [
          "text",
          "Шаг 1: Подготовка накопителя"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Windows:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Откройте \"Управление дисками\" ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "Win+R"
                    ]
                  ]
                ],
                [
                  "text",
                  ", затем "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "diskmgmt.msc"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Проверьте USB-устройство по номеру диска, модели и ёмкости. Не продолжайте, если есть сомнения в деталях."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Щёлкните правой кнопкой мыши по разделу и выберите \"Удалить том\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Щёлкните правой кнопкой мыши по нераспределённому пространству и выберите \"Создать простой том\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Выберите файловую систему: FAT32 (рекомендуется) или NTFS"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Linux:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Установите "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_DISK"
            ]
          ]
        ],
        [
          "text",
          " и "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_PARTITION"
            ]
          ]
        ],
        [
          "text",
          " только на точные пути после проверки модели и ёмкости устройства в "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsblk"
            ]
          ]
        ],
        [
          "text",
          ". Запись "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          " перезапишет таблицу разделов на всём целевом диске. Выполните только одну команду "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          " для нужной файловой системы."
        ]
      ]
    ],
    [
      "code_block",
      "lsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL\nTARGET_DISK=/dev/sdX\nTARGET_PARTITION=/dev/sdX1\nlsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL \"$TARGET_DISK\"\n\n# Create new MBR partition table\nsudo fdisk \"$TARGET_DISK\"\n# In fdisk: o (new table), n (new partition), p (primary), a (bootable), w (write)\n\n# Verify the new partition, then create one filesystem\nlsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL \"$TARGET_DISK\"\nsudo mkfs.vfat -F 32 \"$TARGET_PARTITION\"  # For FAT32\n# Or: sudo mkfs.ext4 \"$TARGET_PARTITION\"  # For ext4",
