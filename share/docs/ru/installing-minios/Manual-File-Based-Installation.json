                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Файловые системы"
                    ]
                  ]
                ],
                [
                  "text",
                  ": FAT32, NTFS, ext2/3/4, Btrfs"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Схема разделов"
                    ]
                  ]
                ],
                [
                  "text",
                  ": MBR"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Загрузка в режиме EFI"
                    ]
                  ]
                ],
                [
                  "text",
                  ": При использовании файловых систем NTFS, exFAT или ext2/3/4 загрузка в режиме EFI может быть недоступна. Для поддержки EFI рекомендуется FAT32."
                ]
              ]
            ]
          ]
        ]
      ]
