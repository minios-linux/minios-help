    [
      "heading",
      1,
      "настройка-загрузочного-меню",
      [
        [
          "text",
          "Настройка загрузочного меню"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Меню загрузки MiniOS предоставляют удобные пункты для популярных режимов загрузки Live-системы. В этом руководстве объясняется, как выбирать и редактировать эти пункты."
        ]
      ]
    ],
    [
      "heading",
      2,
      "обзор",
      [
        [
          "text",
          "Обзор"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Образы MiniOS могут использовать GRUB или Syslinux в зависимости от прошивки, структуры образа и сборки. Их графические меню, клавиши редактирования, поддержка языков и доступные пункты могут отличаться. В конечном итоге загрузчик передает командную строку ядра одному и тому же initrd; см. "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Режимы загрузки"
            ]
          ]
        ],
        [
          "text",
          " для получения информации об исходном источнике, постоянстве, поведении RAM-копирования и зависимости от носителя."
        ]
      ]
    ],
    [
      "heading",
      2,
      "параметры-загрузочного-меню",
      [
        [
          "text",
          "Параметры загрузочного меню"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Предоставляемый образ обычно предлагает следующие варианты, хотя названия, наличие, порядок и выбор по умолчанию могут отличаться в зависимости от образа:"
        ]
      ]
    ],
    [
      "table",
      [
        [
          "table_row",
          true,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Пункт меню"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Типичный селектор initrd"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Назначение"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить MiniOS"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=resume"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Попробовать совместимую с настройками сессию по умолчанию и разрешить создание замены при соблюдении описанных условий."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Начать новую сессию"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=new"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Создать дополнительную пронумерованную постоянную сессию, сохраняя существующие сессии без изменений."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Выбрать сохранённую сессию"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=ask"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Интерактивно выбрать одну из ранее сохранённых сессий. Используйте "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Начать новую сессию"
                    ]
                  ]
                ],
                [
                  "text",
                  " при пустом хранилище."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить без сохранения"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "селектор без постоянства"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Использовать временный записываемый слой в RAM."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить с RAM"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Скопировать всё дерево данных MiniOS на RAM и попытаться отключить исходный носитель."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Это селекторы, а не гарантии того, что хранилище доступно для записи, сессия совместима, объём RAM достаточен или исходный носитель отключён. Подробнее о поведении и комбинациях см. "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Режимы загрузки"
            ]
          ]
        ],
        [
          "text",
          ", о пограничных случаях селекторов — "
        ],
        [
          "link",
          "/reference/boot-process/Persistence-Internals.md",
          null,
          [
            [
              "text",
              "Постоянство initrd"
            ]
          ]
        ],
        [
          "text",
          ", а о производительности и компромиссах ввода-вывода — "
        ],
        [
          "link",
          "/maintenance-and-recovery/Performance.md",
          null,
          [
            [
              "text",
              "Оптимизация производительности"
            ]
          ]
        ],
        [
          "text",
          " для RAM."
        ]
      ]
    ],
