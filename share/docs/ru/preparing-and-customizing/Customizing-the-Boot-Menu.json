    [
      "heading",
      1,
      "настройка-загрузочного-меню",
      [
        [
          "text",
          "Настройка загрузочного меню"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Меню загрузки MiniOS предоставляет удобный выбор для стандартных режимов Live-загрузки. В этом руководстве объясняется, как выбирать и редактировать эти пункты."
        ]
      ]
    ],
    [
      "heading",
      2,
      "обзор",
      [
        [
          "text",
          "Обзор"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Образы MiniOS могут использовать GRUB или Syslinux в зависимости от прошивки, структуры образа и сборки. Их меню, клавиши для редактирования, поддержка языков и доступные пункты могут отличаться. В конечном итоге загрузчик передаёт командную строку ядра одному и тому же initrd; см. "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Режимы загрузки"
            ]
          ]
        ],
        [
          "text",
          " для информации о конечном источнике, работе с постоянством, копировании RAM и зависимости от носителя."
        ]
      ]
    ],
    [
      "heading",
      2,
      "параметры-загрузочного-меню",
      [
        [
          "text",
          "Параметры загрузочного меню"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "В предоставленном образе обычно доступны следующие варианты, однако названия, наличие, порядок и выбор по умолчанию могут отличаться в зависимости от образа:"
        ]
      ]
    ],
    [
      "table",
      [
        [
          "table_row",
          true,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Выбор в меню"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Типичный селектор initrd"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Назначение"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить MiniOS"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=resume"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить совместимую с большинством устройств сессию по умолчанию и разрешить создание новой при выполнении указанных условий."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Начать новую сессию"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=new"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Создать дополнительную пронумерованную постоянную сессию, сохраняя существующие сессии без изменений."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Выбрать сохранённую сессию"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=ask"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Интерактивно выбрать одну из сохранённых сессий. Используйте "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Начать новую сессию"
                    ]
                  ]
                ],
                [
                  "text",
                  " при пустом хранилище."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить без сохранения"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "без селектора постоянства"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Использовать временный доступный для записи слой в RAM."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить из RAM"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Скопировать полностью дерево данных MiniOS на RAM и попытаться отключить исходный носитель."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Это только селекторы, а не гарантия, что хранилище доступно для записи, сессия совместима, объём RAM достаточен или исходный носитель отключён. Подробнее см. "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Режимы загрузки"
            ]
          ]
        ],
        [
          "text",
          " для описания поведения и комбинаций, "
        ],
        [
          "link",
          "/reference/boot-process/Persistence-Internals.md",
          null,
          [
            [
              "text",
              "Постоянство initrd"
            ]
          ]
        ],
        [
          "text",
          " для крайних случаев выбора, а также "
        ],
        [
          "link",
          "/maintenance-and-recovery/Performance.md",
          null,
          [
            [
              "text",
              "Оптимизация производительности"
            ]
          ]
        ],
        [
          "text",
          " для RAM и компромиссов по скорости ввода-вывода."
        ]
      ]
    ],
