    [
      "heading",
      1,
      "настройка-загрузочного-меню",
      [
        [
          "text",
          "Настройка загрузочного меню"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Загрузочные меню MiniOS предоставляют удобный выбор для стандартных режимов загрузки Live-системы. В этом руководстве объясняется, как выбирать и редактировать эти пункты меню."
        ]
      ]
    ],
    [
      "heading",
      2,
      "обзор",
      [
        [
          "text",
          "Обзор"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Образы MiniOS могут использовать GRUB или Syslinux в зависимости от прошивки, структуры образа и сборки. Их меню, клавиши для редактирования, поддержка языков и доступные пункты могут отличаться. В конечном итоге загрузчик передаёт командную строку ядра одному и тому же initrd; см. "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Режимы загрузки"
            ]
          ]
        ],
        [
          "text",
          " для информации о исходных данных, работе с сохранением, поведении копирования RAM и зависимости от носителя."
        ]
      ]
    ],
    [
      "heading",
      2,
      "параметры-загрузочного-меню",
      [
        [
          "text",
          "Параметры загрузочного меню"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "В предоставленном образе обычно доступны следующие варианты, однако названия, наличие, порядок и выбор по умолчанию могут отличаться в зависимости от образа:"
        ]
      ]
    ],
    [
      "table",
      [
        [
          "table_row",
          true,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Пункт меню"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Типичный селектор initrd"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Назначение"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить MiniOS"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=resume"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить совместимую с большинством устройств сессию по умолчанию и разрешить создание новой сессии при выполнении описанных условий."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Начать новую сессию"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=setup"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Открыть выбор хранилища для сохранения, затем создать дополнительную сессию с новым номером, не изменяя уже существующие."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Выбрать сохранённую сессию"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=ask"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Выбрать сохранённую сессию вручную; если хранилище пустое, MiniOS запускает тот же процесс создания первой сессии."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить без сохранения"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "без выбора сохранения"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Использовать временный записываемый слой в RAM."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Запустить из RAM"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Скопировать системные данные MiniOS на RAM; при наличии сохранения по умолчанию "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchtoram=trim"
                    ]
                  ]
                ],
                [
                  "text",
                  " отдельно копируется выбранная поддерживаемая сессия."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Это только селекторы, а не гарантия, что носитель доступен для записи, сессия совместима, объём RAM достаточен или исходный носитель отключён. Подробнее см. "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Режимы загрузки"
            ]
          ]
        ],
        [
          "text",
          " о поведении и комбинациях, "
        ],
        [
          "link",
          "/reference/boot-process/Persistence-Internals.md",
          null,
          [
            [
              "text",
              "Сохранение в initrd"
            ]
          ]
        ],
        [
          "text",
          " о нюансах выбора, а также "
        ],
        [
          "link",
          "/maintenance-and-recovery/Performance.md",
          null,
          [
            [
              "text",
              "Оптимизация производительности"
            ]
          ]
        ],
        [
          "text",
          " для RAM и особенностей работы с вводом/выводом."
        ]
      ]
    ],
