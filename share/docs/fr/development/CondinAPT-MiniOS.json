      "#!/bin/bash\nset -e\n\n# Load MiniOS library\n. /minioslib || exit 1\n\n# Check module conditions\nif [ \"$PACKAGE_VARIANT\" = \"minimum\" ] && [ \"$DESKTOP_ENVIRONMENT\" = \"core\" ]; then\n    echo \"Skipping module for minimal core build\"\n    exit 0\nfi\n\n# Install packages\n/linux-live/condinapt \\\n    -l \"$CWD/packages.list\" \\\n    -c /linux-live/build.conf \\\n    -m /linux-live/condinapt.map",
