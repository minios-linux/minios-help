    [
      "heading",
      3,
      "étape-1-préparer-le-support",
      [
        [
          "text",
          "Étape 1 : Préparer le support"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Windows :"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Ouvrez \"Gestion des disques\" ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "Win+R"
                    ]
                  ]
                ],
                [
                  "text",
                  ", puis "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "diskmgmt.msc"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Vérifiez le périphérique USB selon son numéro de disque, son modèle et sa capacité. N’allez pas plus loin si un détail est incertain."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Faites un clic droit sur son volume et sélectionnez \"Supprimer le volume\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Faites un clic droit sur l’espace non alloué et sélectionnez \"Nouveau volume simple\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Choisissez le système de fichiers : FAT32 (recommandé) ou NTFS"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Linux :"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Définissez "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_DISK"
            ]
          ]
        ],
        [
          "text",
          " et "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_PARTITION"
            ]
          ]
        ],
        [
          "text",
          " sur les chemins exacts uniquement après avoir vérifié le modèle et la capacité du périphérique dans "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsblk"
            ]
          ]
        ],
        [
          "text",
          ". L’écriture "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          " remplace la table de partitions sur l’ensemble du disque cible. Exécutez un seul "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          " correspondant au système de fichiers souhaité."
        ]
      ]
    ],
    [
