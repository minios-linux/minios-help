    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Le Configurateur modifie "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/etc/live/config.conf"
            ]
          ]
        ],
        [
          "text",
