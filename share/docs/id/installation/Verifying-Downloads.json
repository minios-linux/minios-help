      "heading",
      1,
      "memverifikasi-unduhan",
      [
        [
          "text",
          "Memverifikasi unduhan"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Rilis MiniOS dipublikasikan di "
        ],
        [
          "link",
          "https://github.com/minios-linux/minios-live/releases",
          null,
          [
            [
              "text",
              "Halaman Rilis GitHub resmi"
            ]
          ]
        ],
        [
          "text",
          ". Setiap aset rilis ISO memiliki file pendamping dengan nama yang diakhiri "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".iso.sha256"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Verifikasi SHA-256 mendeteksi unduhan yang tidak lengkap atau telah diubah. Namun, ini tidak membuktikan siapa pembuat file tersebut. Rilis saat ini hanya menyediakan checksum, bukan file tanda tangan kriptografi, sehingga halaman ini tidak membahas verifikasi tanda tangan."
        ]
      ]
    ],
    [
      "heading",
      2,
      "unduh-kedua-file",
      [
        [
          "text",
          "Unduh kedua file"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Unduh file ISO dan file "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sha256"
            ]
          ]
        ],
        [
          "text",
          " yang sesuai dari rilis GitHub yang sama. Simpan kedua file tersebut di direktori yang sama. Nama dasar keduanya harus sama, misalnya:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-trixie-xfce-standard-amd64-5.1.1.iso\nminios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Gunakan nama dari rilis yang Anda unduh pada perintah di bawah ini."
        ]
      ]
    ],
    [
      "heading",
      2,
      "linux",
      [
        [
          "text",
          "Linux"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Buka terminal di direktori unduhan dan jalankan:"
        ]
      ]
    ],
    [
      "code_block",
      "sha256sum --check minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "bash",
      [
        [
          "syntax",
          "sha256sum",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "--check",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Unduhan yang valid akan menampilkan nama ISO diikuti oleh "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "OK"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
