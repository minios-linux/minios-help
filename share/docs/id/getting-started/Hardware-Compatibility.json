      [
        [
          "text",
          "Grafis"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image MiniOS amd64 saat ini menggunakan stack grafis Debian dengan Xorg dan Mesa."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Kernel sudah mencakup driver Intel "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "i915"
            ]
          ]
        ],
        [
          "text",
          " dan "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "xe"
            ]
          ]
        ],
        [
          "text",
          ", AMD "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "amdgpu"
            ]
          ]
        ],
        [
          "text",
          " dan "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "radeon"
            ]
          ]
        ],
        [
          "text",
          ", serta driver open-source NVIDIA "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "nouveau"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Xorg menyertakan driver generik "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "modesetting"
            ]
          ]
        ],
        [
          "text",
          " bersama dengan driver Intel, AMD/ATI, Radeon, Nouveau, VESA, dan framebuffer. Mesa menyediakan stack akselerasi 3D standar yang digunakan oleh Intel, AMD, dan driver open-source yang didukung."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image MiniOS berbasis Debian menginstal koleksi firmware Debian bersama paket firmware khusus vendor. Image Trixie Standard saat ini menyertakan "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "firmware-amd-graphics"
            ]
          ]
        ],
        [
          "text",
          " dan "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "firmware-misc-nonfree"
            ]
          ]
        ],
        [
          "text",
          "; image berbasis Ubuntu menggunakan "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "linux-firmware"
            ]
          ]
        ],
        [
          "text",
          " sebagai gantinya."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Daftar paket MiniOS yang dipelihara tidak mencakup driver kernel NVIDIA proprietary. Karena itu, perangkat keras NVIDIA menggunakan driver "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "nouveau"
            ]
          ]
        ],
        [
          "text",
          " yang sudah disertakan secara default. Perangkat keras atau fitur yang secara khusus membutuhkan driver proprietary NVIDIA harus ditambahkan secara terpisah."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Grafis virtual juga didukung oleh driver kernel dan Xorg untuk perangkat VMware, QXL, Bochs, dan Hyper-V yang umum."
        ]
      ]
    ],
    [
