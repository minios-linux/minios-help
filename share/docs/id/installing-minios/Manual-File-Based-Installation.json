                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Sistem file"
                    ]
                  ]
                ],
                [
                  "text",
                  ": FAT32, NTFS, ext2/3/4, Btrfs"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
