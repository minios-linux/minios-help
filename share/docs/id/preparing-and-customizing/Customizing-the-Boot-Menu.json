    [
      "heading",
      1,
      "kustomisasi-menu-boot",
      [
        [
          "text",
          "Kustomisasi menu boot"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Menu boot MiniOS menyediakan entri yang praktis untuk mode live boot yang umum digunakan. Panduan ini menjelaskan cara memilih dan mengedit entri-entri tersebut."
        ]
      ]
    ],
    [
      "heading",
      2,
      "ikhtisar",
      [
        [
          "text",
          "Ikhtisar"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image MiniOS dapat menggunakan GRUB atau Syslinux tergantung pada firmware, tata letak image, dan build. Grafik menu, tombol pengeditan, penanganan bahasa, dan entri yang tersedia tidak selalu identik. Bootloader pada akhirnya akan meneruskan command line kernel ke initrd yang sama; lihat "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Mode Boot"
            ]
          ]
        ],
        [
          "text",
          " untuk sumber yang dihasilkan, persistensi, perilaku RAM-copy, dan ketergantungan media."
        ]
      ]
    ],
    [
      "heading",
      2,
      "opsi-menu-boot",
      [
        [
          "text",
          "Opsi Menu Boot"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image yang disediakan umumnya menampilkan pilihan semantik berikut, meskipun judul, ketersediaan, urutan, dan pilihan default dapat berbeda-beda tergantung image:"
        ]
      ]
    ],
    [
      "table",
      [
        [
          "table_row",
          true,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Pilihan menu"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Selector initrd tipikal"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Tujuan"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Mulai MiniOS"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=resume"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Mencoba sesi kompatibel default dan mengizinkan pembuatan pengganti sesuai kondisi yang didokumentasikan."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Mulai sesi baru"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=new"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Membuat sesi persisten bernomor tambahan tanpa mengubah sesi yang sudah ada."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Pilih sesi tersimpan"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=ask"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Memilih sesi tersimpan yang sudah ada secara interaktif. Gunakan "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Mulai sesi baru"
                    ]
                  ]
                ],
                [
                  "text",
                  " jika penyimpanan kosong."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Mulai tanpa menyimpan"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "selector tanpa persistensi"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Menggunakan layer writable sementara di RAM."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Jalankan dari RAM"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Menyalin seluruh pohon data MiniOS ke RAM dan mencoba melepas sumbernya."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
