    [
      "heading",
      1,
      "kustomisasi-menu-boot",
      [
        [
          "text",
          "Kustomisasi Menu Boot"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Menu boot MiniOS menyediakan entri yang praktis untuk mode live boot yang umum. Panduan ini menjelaskan cara memilih dan mengedit entri tersebut."
        ]
      ]
    ],
    [
      "heading",
      2,
      "ikhtisar",
      [
        [
          "text",
          "Ikhtisar"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image MiniOS dapat menggunakan GRUB atau Syslinux tergantung pada firmware, tata letak image, dan build. Struktur menu, tombol pengeditan, penanganan bahasa, serta entri yang tersedia bisa berbeda. Bootloader pada akhirnya akan meneruskan kernel command line ke initrd yang sama; lihat "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Mode Boot"
            ]
          ]
        ],
        [
          "text",
          " untuk sumber yang dihasilkan, persistensi, perilaku salin-RAM, dan ketergantungan media."
        ]
      ]
    ],
    [
      "heading",
      2,
      "opsi-menu-boot",
      [
        [
          "text",
          "Opsi Menu Boot"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image yang disediakan umumnya menampilkan pilihan semantik berikut, meskipun judul, ketersediaan, urutan, dan pilihan default dapat berbeda pada setiap image:"
        ]
      ]
    ],
    [
      "table",
      [
        [
          "table_row",
          true,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Pilihan menu"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Selector initrd yang umum"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Tujuan"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Mulai MiniOS"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=resume"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Coba sesi kompatibel default dan izinkan pembuatan pengganti sesuai kondisi yang didokumentasikan."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Mulai sesi baru"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=setup"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Buka pemilih backend-persistensi, lalu buat sesi bernomor tambahan tanpa mengubah sesi yang sudah ada."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Pilih sesi yang disimpan"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=ask"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Pilih sesi tersimpan yang sudah ada secara interaktif; jika penyimpanan kosong, MiniOS akan masuk ke alur pengaturan yang sama agar sesi pertama dapat dibuat."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Mulai tanpa menyimpan"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "tanpa pemilih persistensi"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Gunakan layer writable sementara di RAM."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Jalankan dari RAM"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Salin data sistem MiniOS ke RAM; dengan persistensi, default "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchtoram=trim"
                    ]
                  ]
                ],
                [
                  "text",
                  " menyalin sesi yang didukung dan dipilih secara terpisah."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Ini adalah pemilih, bukan jaminan bahwa penyimpanan dapat ditulis, sesi kompatibel, RAM mencukupi, atau media sumber telah dilepas. Lihat "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Mode Boot"
            ]
          ]
        ],
        [
          "text",
          " untuk perilaku dan kombinasi, "
        ],
        [
          "link",
          "/reference/boot-process/Persistence-Internals.md",
          null,
          [
            [
              "text",
              "Persistensi initrd"
            ]
          ]
        ],
        [
          "text",
          " untuk kasus khusus pemilih, dan "
        ],
        [
          "link",
          "/maintenance-and-recovery/Performance.md",
          null,
          [
            [
              "text",
              "Optimasi Performa"
            ]
          ]
        ],
        [
          "text",
          " untuk RAM dan pertimbangan I/O."
        ]
      ]
    ],
