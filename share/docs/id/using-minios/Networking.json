          "code",
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          " membuat kebijakan kabel ulang. Mengubah koneksi Wi-Fi atau Ethernet biasa tidak memerlukannya."
        ]
