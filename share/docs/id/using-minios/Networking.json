        [
          "text",
          "NetworkManager mengonfigurasi sistem MiniOS yang sedang berjalan. Jaringan yang digunakan initramfs untuk mendapatkan MiniOS sendiri merupakan mekanisme terpisah."
        ]
      ]
    ],
