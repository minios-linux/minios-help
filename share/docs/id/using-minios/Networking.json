      "heading",
      1,
      "jaringan",
      [
        [
          "text",
          "Jaringan"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS menggunakan "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "NetworkManager"
            ]
          ]
        ],
        [
          "text",
          " untuk koneksi jaringan kabel dan Wi-Fi secara normal. MiniOS tidak menggantikan model koneksi tersebut dengan sistem konfigurasi jaringan terpisah."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Untuk penggunaan sehari-hari, buka ikon jaringan di panel desktop. Alat standar NetworkManager juga tersedia:"
        ]
      ]
    ],
    [
      "code_block",
      "nmtui\nnmcli",
      "bash",
      [
        [
          "syntax",
          "nmtui",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          "\n",
          "#24292e",
          "#e1e4e8"
        ],
        [
          "syntax",
          "nmcli",
          "#6F42C1",
          "#B392F0"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Gunakan alat ini untuk menghubungkan ke Wi-Fi, berpindah jaringan, mengatur DHCP atau alamat statis, DNS, koneksi VPN, dan pengaturan jaringan lain saat runtime. Untuk perilaku lengkapnya, silakan lihat dokumentasi dan manual NetworkManager."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Pada sesi persisten MiniOS, profil koneksi NetworkManager akan disimpan sebagai bagian dari sesi tersebut. Pada "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Mulai tanpa menyimpan"
            ]
          ]
        ],
        [
          "text",
          ", perubahan akan hilang saat shutdown."
        ]
      ]
    ],
    [
      "heading",
      2,
      "pra-konfigurasi-jaringan",
      [
        [
          "text",
          "Pra-konfigurasi jaringan"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Pengaturan jaringan khusus MiniOS terutama berupa "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "pra-konfigurasi"
            ]
          ]
        ],
        [
          "text",
          ". Ini berguna ketika sebuah image, installer, atau deployment tanpa pengawasan perlu memulai dengan konfigurasi kabel yang sudah diketahui sebelum pengguna membuka NetworkManager."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Komponen jaringan MiniOS "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          " mendukung pra-konfigurasi IPv4 kabel. Tidak mendukung pra-konfigurasi Wi-Fi."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Contoh statis di "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "config.conf"
            ]
          ]
        ],
        [
          "text",
          " adalah:"
        ]
      ]
    ],
