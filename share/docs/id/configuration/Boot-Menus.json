    [
      "heading",
      1,
      "panduan-menu-boot-minios",
      [
        [
          "text",
          "Panduan Menu Boot MiniOS"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Menu boot MiniOS menyediakan entri praktis untuk mode live boot yang umum. Panduan ini menjelaskan cara memilih dan mengedit entri-entri tersebut."
        ]
      ]
    ],
    [
      "heading",
      2,
      "ikhtisar",
      [
        [
          "text",
          "Ikhtisar"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image MiniOS dapat menggunakan GRUB atau Syslinux tergantung pada firmware, tata letak image, dan build. Tampilan menu, tombol pengeditan, penanganan bahasa, dan entri yang tersedia tidak selalu sama. Bootloader pada akhirnya akan meneruskan baris perintah kernel ke initrd yang sama; lihat "
        ],
        [
          "link",
          "/configuration/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Boot modes"
            ]
          ]
        ],
        [
          "text",
          " untuk perilaku sumber, persistensi, salin ke RAM, dan ketergantungan media."
        ]
      ]
    ],
    [
      "heading",
      2,
      "opsi-menu-boot",
      [
        [
          "text",
          "Opsi Menu Boot"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Image yang disediakan umumnya menawarkan pilihan semantik berikut, meskipun judul, ketersediaan, urutan, dan pilihan default dapat berbeda pada setiap image:"
        ]
      ]
    ],
    [
      "table",
      [
        [
          "table_row",
          true,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Pilihan Menu"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Selector initrd umum"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Tujuan"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Lanjutkan Sesi Sebelumnya"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=resume"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Mencoba sesi kompatibel default dan mengizinkan pembuatan pengganti sesuai ketentuan yang dijelaskan."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Mulai Sesi Baru"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=new"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Membuat sesi persisten baru dengan nomor unik."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Pilih Sesi Saat Startup"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=ask"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Memilih sesi yang sudah ada atau meminta sesi baru secara interaktif."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Awal Baru"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "tanpa selector persistensi"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Menggunakan layer writable sementara."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
