        [
          "text",
          "Penanganan resolusi Xfce"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS menyediakan "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/usr/bin/minios-virtual-resolution"
            ]
          ]
        ],
        [
          "text",
          " hingga "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-tools"
            ]
          ]
        ],
        [
          "text",
          " dan menjalankannya dari sesi autostart Xfce. Utilitas ini mendeteksi mesin virtual umum dan hanya menggunakan XRandR jika guest tools aktif belum mengelola tampilan."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Tanpa override, resolusi yang diminta adalah "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "1280x800"
            ]
          ]
        ],
        [
          "text",
          ". Gunakan "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "virtres=WIDTHxHEIGHT"
            ]
          ]
        ],
        [
          "text",
          " untuk meminta resolusi lain atau "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "novirtres"
            ]
          ]
        ],
        [
          "text",
          " untuk menonaktifkan penyesuaian MiniOS ini."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Setelah penyesuaian berhasil, utilitas akan membuat "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "~/.config/minios/virtual-resolution-configured"
            ]
          ]
        ],
        [
          "text",
          ". Dalam sesi persisten, penyesuaian otomatis tidak akan diterapkan lagi hingga marker tersebut dihapus."
        ]
      ]
    ],
