    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Untuk kompatibilitas paling luas, pasang media boot MiniOS dan disk virtual apa pun yang akan berisi instalasi live MiniOS melalui "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "IDE atau SATA controller"
            ]
          ]
        ],
        [
          "text",
          ". Rekomendasi ini berlaku untuk VirtualBox, VMware, QEMU/KVM, dan Hyper-V selama controller tersebut tersedia."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Controller penyimpanan virtual lain bisa digunakan, namun MiniOS harus dapat mengakses sumber live-nya selama tahap initramfs, sebelum seluruh pohon modul kernel dari "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "01-kernel-*.sb"
            ]
          ]
        ],
        [
          "text",
          " tersedia."
        ]
      ]
