              "table_cell",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Toolbox"
                    ]
                  ]
                ],
                [
                  "text",
                  ""
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "756 MB"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Ultra"
                    ]
