        [
          "text",
          "Quick start"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "This guide takes you from a downloaded MiniOS image to a working system. It covers only the decisions needed for a first start; the linked guides explain each topic in detail."
        ]
      ]
    ],
