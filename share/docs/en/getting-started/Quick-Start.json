        [
          "link",
          "/installing-minios/Installation-Methods.md",
          null,
          [
            [
              "text",
              "Installing MiniOS"
            ]
          ]
        ],
        [
          "text",
          " for the differences between raw image writing, Ventoy, file-based layouts, and MiniOS Installer."
        ]
      ]
