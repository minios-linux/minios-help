  "nodes": [
    [
      "heading",
      1,
      "minios-configurator",
      [
        [
          "text",
          "MiniOS Configurator"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS Configurator is a graphical editor for MiniOS "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          " settings. It"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "validates changes and writes configuration for a later boot. It does not change"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the running system directly."
        ]
      ]
    ],
    [
      "heading",
      2,
      "start-the-configurator",
      [
        [
          "text",
          "Start the configurator"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Open MiniOS Configurator from the application menu or run:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-configurator",
      "bash",
      [
        [
          "syntax",
          "minios-configurator",
          "#6F42C1",
          "#B392F0"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The default target is "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/etc/live/config.conf"
            ]
          ]
        ],
        [
          "text",
          ". To edit another regular file,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "pass its path:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-configurator /path/to/config.conf",
      "bash",
      [
        [
          "syntax",
          "minios-configurator",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "/path/to/config.conf",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Saving requires PolicyKit authentication. Symlinks and non-regular target files"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "are rejected."
        ]
      ]
    ],
    [
      "heading",
      2,
      "media-and-runtime-configuration",
      [
        [
          "text",
          "Media and runtime configuration"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS can read configuration from two locations:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "minios/config.conf"
                    ]
                  ]
                ],
                [
                  "text",
                  " and "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "minios/config.conf.d/*.conf"
                    ]
                  ]
                ],
                [
                  "text",
                  " on the live medium"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "/etc/live/config.conf"
                    ]
                  ]
                ],
                [
                  "text",
                  " and "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "/etc/live/config.conf.d/*.conf"
                    ]
                  ]
                ],
                [
                  "text",
                  " in the running"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "root filesystem"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The Configurator edits the selected file only. With no path argument, it edits"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the runtime file "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/etc/live/config.conf"
            ]
          ]
        ],
        [
          "text",
          "; it does not directly open the medium"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "file. MiniOS synchronizes newer configuration between the runtime filesystem"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "and writable MiniOS media during boot. Read-only media cannot receive runtime"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "changes, and persistent runtime configuration can remain independent of the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "media copy."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "For a given option, kernel parameters take precedence over configuration files,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "and media configuration takes precedence over root-filesystem configuration."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Use "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "-i"
            ]
          ]
        ],
        [
          "text",
          " to overlay recognized settings from the current kernel command line in"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the editor:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-configurator --inherit-cmdline /etc/live/config.conf",
      "bash",
      [
        [
          "syntax",
          "minios-configurator",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "--inherit-cmdline",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "/etc/live/config.conf",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The selected file remains the save target. Unknown kernel parameters are"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "ignored."
        ]
      ]
    ],
    [
      "heading",
      2,
      "when-settings-apply",
      [
        [
          "text",
          "When settings apply"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Every control states when it is used. Saving never applies a setting to the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "current session."
        ]
      ]
    ],
    [
      "heading",
      3,
      "applied-after-reboot",
      [
        [
          "text",
          "Applied after reboot"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Hostname, locale, timezone, keyboard, boot target, service selection, module"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "mode, user-directory media handling, debug settings, and log export are read on"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "a later boot. Reboot after saving to apply them."
        ]
      ]
    ],
    [
      "heading",
      3,
      "used-only-for-a-new-session",
      [
        [
          "text",
          "Used only for a new session"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Account creation, user and root passwords, "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "noroot"
            ]
          ]
        ],
        [
          "text",
          ", sudo and PolicyKit policy,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "SSH and XRDP policy, X11 access, password hints, and screen locking are one-shot"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "settings. A persistent session normally records completed "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "components under "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/var/lib/live/config/"
            ]
          ]
        ],
        [
          "text",
          ", so changing these values and rebooting"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the same session does not recreate the account or security state. Start a new"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "session to apply them as initial settings."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Security profiles are editor presets. The profile name is not saved; the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "individual security settings are saved and remain editable."
        ]
      ]
    ],
    [
      "heading",
      2,
      "user-directories-and-persistence",
      [
        [
          "text",
          "User directories and persistence"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Linking and bind mounting user directories are mutually exclusive. Both use an"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "existing writable local MiniOS data medium and a safe media-relative path. They"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "are unavailable with "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram=full"
            ]
          ]
        ],
        [
          "text",
          ", or "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram=trim"
            ]
          ]
        ],
        [
          "text",
          ", and MiniOS does not"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "merge two populated directory trees automatically."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "perchmode"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "perchsize"
            ]
          ]
        ],
        [
          "text",
          " are initramfs boot parameters, not Configurator"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "settings. The Configurator does not create, unlock, resize, or repair a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "persistence container. For encrypted persistence it only reports whether the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "initramfs encryption marker is present."
        ]
      ]
    ],
    [
      "heading",
      2,
      "save-behavior",
      [
        [
          "text",
          "Save behavior"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Review lists only changed values and redacts passwords. Saving updates only"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "changed keys while preserving comments, ordering, unknown keys, ownership,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "permissions, and extended attributes. The write is atomic."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "For the full variable and boot-parameter reference, see"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/configuration/Configuration-File.md",
          null,
          [
            [
              "text",
              "Configuration file"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/configuration/Boot-Parameters.md",
          null,
          [
            [
              "text",
              "Boot parameters"
            ]
          ]
        ],
        [
          "text",
          ", and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/configuration/live-config.md",
          null,
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ]
  ],
  "plain_text": "MiniOS Configurator\nMiniOS Configurator is a graphical editor for MiniOS live-config settings. It\nvalidates changes and writes configuration for a later boot. It does not change\nthe running system directly.\nStart the configurator\nOpen MiniOS Configurator from the application menu or run:\nminios-configurator\nThe default target is /etc/live/config.conf. To edit another regular file,\npass its path:\nminios-configurator /path/to/config.conf\nSaving requires PolicyKit authentication. Symlinks and non-regular target files\nare rejected.\nMedia and runtime configuration\nMiniOS can read configuration from two locations:\nminios/config.conf and minios/config.conf.d/*.conf on the live medium\n/etc/live/config.conf and /etc/live/config.conf.d/*.conf in the running\nroot filesystem\nThe Configurator edits the selected file only. With no path argument, it edits\nthe runtime file /etc/live/config.conf; it does not directly open the medium\nfile. MiniOS synchronizes newer configuration between the runtime filesystem\nand writable MiniOS media during boot. Read-only media cannot receive runtime\nchanges, and persistent runtime configuration can remain independent of the\nmedia copy.\nFor a given option, kernel parameters take precedence over configuration files,\nand media configuration takes precedence over root-filesystem configuration.\nUse -i to overlay recognized settings from the current kernel command line in\nthe editor:\nminios-configurator --inherit-cmdline /etc/live/config.conf\nThe selected file remains the save target. Unknown kernel parameters are\nignored.\nWhen settings apply\nEvery control states when it is used. Saving never applies a setting to the\ncurrent session.\nApplied after reboot\nHostname, locale, timezone, keyboard, boot target, service selection, module\nmode, user-directory media handling, debug settings, and log export are read on\na later boot. Reboot after saving to apply them.\nUsed only for a new session\nAccount creation, user and root passwords, noroot, sudo and PolicyKit policy,\nSSH and XRDP policy, X11 access, password hints, and screen locking are one-shot\nsettings. A persistent session normally records completed live-config\ncomponents under /var/lib/live/config/, so changing these values and rebooting\nthe same session does not recreate the account or security state. Start a new\nsession to apply them as initial settings.\nSecurity profiles are editor presets. The profile name is not saved; the\nindividual security settings are saved and remain editable.\nUser directories and persistence\nLinking and bind mounting user directories are mutually exclusive. Both use an\nexisting writable local MiniOS data medium and a safe media-relative path. They\nare unavailable with toram, toram=full, or toram=trim, and MiniOS does not\nmerge two populated directory trees automatically.\nperchmode and perchsize are initramfs boot parameters, not Configurator\nsettings. The Configurator does not create, unlock, resize, or repair a\npersistence container. For encrypted persistence it only reports whether the\ninitramfs encryption marker is present.\nSave behavior\nReview lists only changed values and redacts passwords. Saving updates only\nchanged keys while preserving comments, ordering, unknown keys, ownership,\npermissions, and extended attributes. The write is atomic.\nFor the full variable and boot-parameter reference, see\nConfiguration file,\nBoot parameters, and\nlive-config.",
  "product_kind": "minios-markup-document",
  "schema_version": 1
}
