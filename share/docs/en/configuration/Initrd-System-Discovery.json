    [
      "heading",
      2,
      "copying-and-detaching-with-toramfull",
      [
        [
          "text",
          "Copying and detaching with "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram=full"
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "toram=full"
            ]
          ]
        ],
        [
          "text",
          " matters to discovery because it may remove the continuing"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "dependency on the selected source. After discovery, MiniOS copies the data tree"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "to RAM and then tries to unmount the source and move the RAM copy into its"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "place. Only a successful unmount and move detach local media, a loop-mounted"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "ISO, or an HTTP ISO."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Sharp limitations:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "There is no preflight check that available RAM can hold the copy."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "When persistence is requested, the top-level "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "*"
                    ]
                  ]
                ],
                [
                  "text",
                  " copy omits dotfiles."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "When persistence is not requested, the "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "changes"
                    ]
                  ]
                ],
                [
                  "text",
                  " entry is deliberately"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "omitted. That branch copies other top-level entries, including dotfiles."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "A copy, unmount, or move failure can leave the original source mounted. Do"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "not assume that specifying "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram=full"
                    ]
                  ]
                ],
                [
                  "text",
                  " makes media removal or network loss"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "safe; verify that detachment succeeded."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "See "
        ],
        [
          "link",
          "/configuration/Initrd-Persistence.md",
          null,
