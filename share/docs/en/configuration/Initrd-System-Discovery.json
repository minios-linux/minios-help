  "nodes": [
    [
      "heading",
      1,
      "initrd-system-discovery",
      [
        [
          "text",
          "Initrd system discovery"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "After the bootloader loads the kernel and initramfs, the initramfs must locate"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the MiniOS data tree that supplies the "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sb"
            ]
          ]
        ],
        [
          "text",
          " system modules. This happens before"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the normal userspace network stack, desktop, and persistent session are active."
        ]
      ]
    ],
    [
      "heading",
      2,
      "source-precedence",
      [
        [
          "text",
          "Source precedence"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Source selection has a fixed precedence:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "A literal "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=http://..."
                    ]
                  ]
                ],
                [
                  "text",
                  " value selects an HTTP ISO."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Otherwise, any nonempty "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " value selects PXE download."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Otherwise, "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=askdisk"
                    ]
                  ]
                ],
                [
                  "text",
                  " or "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=askdisk:..."
                    ]
                  ]
                ],
                [
                  "text",
                  " opens the disk selector."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Otherwise, the initramfs scans local block devices."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The two network paths do not fall back to local media. After an HTTP ISO or PXE"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "attempt, discovery returns that network result rather than trying disks; an"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "unusable or incomplete result fails validation or later setup."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "This order has two important consequences:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from=http://..."
                    ]
                  ]
                ],
                [
                  "text",
                  " wins over "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  ". The optional "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " then supplies static"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "addressing for the HTTP ISO connection."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "A nonempty "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " wins over every local "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "from="
                    ]
                  ]
                ],
                [
                  "text",
                  " value, including a device,"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "directory, ISO path, or "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "askdisk"
                    ]
                  ]
                ],
                [
                  "text",
                  ". Do not use "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "ip="
                    ]
                  ]
                ],
                [
                  "text",
                  " merely to configure the"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "network of a locally booted system."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "heading",
      2,
      "local-discovery",
      [
        [
          "text",
          "Local discovery"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Without an HTTP source or nonempty "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          ", MiniOS makes 45 discovery passes,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "approximately one per second. Each pass refreshes device nodes, obtains block"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "device candidates from "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "blkid"
            ]
          ]
        ],
        [
          "text",
          ", sorts their device names, and tests them in that"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "order. The first candidate containing a qualifying MiniOS source is retained;"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "later devices are not considered."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "If "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from="
            ]
          ]
        ],
        [
          "text",
          " is empty, the path tested on each filesystem is "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          ". A source"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "qualifies when either that directory or its immediate "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "modules/"
            ]
          ]
        ],
        [
          "text",
          " subdirectory"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "contains at least one file whose extension is "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sb"
            ]
          ]
        ],
        [
          "text",
          " by default. The "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "bext="
            ]
          ]
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "parameter changes the extension used by this test. Discovery does not validate"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "that the found module set is complete or bootable."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Each candidate is initially mounted read-only. After it qualifies, MiniOS tries"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "to make that selected data mount writable, but inability to do so does not"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "reject an otherwise valid source."
        ]
      ]
    ],
    [
      "heading",
      3,
      "local-from-forms",
      [
        [
          "text",
          "Local "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from="
            ]
          ]
        ],
        [
          "text",
          " forms"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "An ordinary relative or absolute-looking path is interpreted inside every"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "candidate filesystem. Leading slashes are normalized by path construction, so"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "these both look for the same directory:"
        ]
      ]
    ],
    [
      "code_block",
      "from=minios\nfrom=/minios",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "If the requested path is a regular file on a candidate filesystem, MiniOS"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "treats it as an ISO, loop-mounts it read-only, and tests the "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          " directory"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "inside the ISO:"
        ]
      ]
    ],
    [
      "code_block",
      "from=/images/minios.iso",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Device-qualified paths support only these forms:"
        ]
      ]
    ],
    [
      "code_block",
      "from=/dev/sdb1/minios\nfrom=/dev/sr0/minios\nfrom=/dev/disk/by-label/MINIOS/minios",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "/dev/<name>/path"
            ]
          ]
        ],
        [
          "text",
          " supports a simple device name followed by a path. The label"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "form must be exactly "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/dev/disk/by-label/LABEL/path"
            ]
          ]
        ],
        [
          "text",
          "; the label is resolved with"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "blkid"
            ]
          ]
        ],
        [
          "text",
          ", then the remaining path is tested on that filesystem."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "There is no corresponding parser for UUID, PARTUUID, or by-id paths. Forms such"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "as the following are not supported:"
        ]
      ]
    ],
    [
      "code_block",
      "from=/dev/disk/by-uuid/UUID/minios\nfrom=/dev/disk/by-partuuid/PARTUUID/minios\nfrom=/dev/disk/by-id/ID/minios",
      "",
      []
    ],
    [
      "heading",
      3,
      "interactive-selection",
      [
        [
          "text",
          "Interactive selection"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Use "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "askdisk"
            ]
          ]
        ],
        [
          "text",
          " to select a partition and then test a path on it:"
        ]
      ]
    ],
    [
      "code_block",
      "from=askdisk\nfrom=askdisk:custom:dir",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The first form tests "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          " on the selected partition. In the second form,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "colons become path separators, so "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "askdisk:custom:dir"
            ]
          ]
        ],
        [
          "text",
          " tests "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "custom/dir"
            ]
          ]
        ],
        [
          "text",
          "."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Slash syntax such as "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from=askdisk/custom/dir"
            ]
          ]
        ],
        [
          "text",
          " still opens the selector but"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "silently loses the custom path and tests "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios"
            ]
          ]
        ],
        [
          "text",
          "; do not use it."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The displayed device list is refreshed while the selector is open and excludes"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "swap filesystems. Selection still performs the normal module-presence test; a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "chosen partition alone is not sufficient."
        ]
      ]
    ],
    [
      "heading",
      2,
      "http-iso",
      [
        [
          "text",
          "HTTP ISO"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "An HTTP ISO source has this form:"
        ]
      ]
    ],
    [
      "code_block",
      "from=http://server.example/path/minios.iso",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Only plain HTTP is recognized. HTTPS and other URL schemes are not supported."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "The initramfs finds the first detected non-loopback network interface, brings up"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the network, and mounts the remote ISO through "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "httpfs2"
            ]
          ]
        ],
        [
          "text",
          ". Interface selection"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "does not verify link, reachability, or whether that interface is the usable one"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "on a multi-NIC system."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "When "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          " is absent, HTTP ISO boot requests DHCP with "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "udhcpc"
            ]
          ]
        ],
        [
          "text",
          ". When "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          " is"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "present, it uses the static fields expected by the PXE parser:"
        ]
      ]
    ],
    [
      "code_block",
      "ip=<client-ip>:<server-ip>:<gateway-ip>:<netmask>[:<port>]",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "For HTTP ISO boot, the URL still determines the HTTP server. The static fields"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "configure the client address, netmask, default gateway, and early DNS entries;"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the optional port field belongs to PXE file download and does not replace the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "port in the ISO URL."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "cache=<MB>"
            ]
          ]
        ],
        [
          "text",
          " enables an httpfs cache of the requested size in "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/tmp"
            ]
          ]
        ],
        [
          "text",
          ". It is a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "cache, not a guaranteed complete download. The running system continues to"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "depend on the remote ISO and network unless a successful RAM copy detaches the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "source."
        ]
      ]
    ],
    [
      "heading",
      2,
      "pxe-data-download",
      [
        [
          "text",
          "PXE data download"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Any nonempty "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          " selects PXE data download unless "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from=http://..."
            ]
          ]
        ],
        [
          "text",
          " was"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "selected first. The supported syntax is:"
        ]
      ]
    ],
    [
      "code_block",
      "ip=<client-ip>:<server-ip>:<gateway-ip>:<netmask>[:<port>]",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The netmask is dotted IPv4 notation. The optional HTTP port defaults to "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "7529"
            ]
          ]
        ],
        [
          "text",
          "."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Generic kernel or dracut forms such as "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip=dhcp"
            ]
          ]
        ],
        [
          "text",
          " and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip=:::::eth0:dhcp"
            ]
          ]
        ],
        [
          "text",
          " are not supported. PXE data download itself has no DHCP"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "form in this parser."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS configures the first detected non-loopback interface without proving it"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "has a working link. It first requests "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "PXEFILELIST"
            ]
          ]
        ],
        [
          "text",
          " and the listed MiniOS files"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "over HTTP from the server field. TFTP is a limited fallback: it is selected only"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "when the initial HTTP request for "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "PXEFILELIST"
            ]
          ]
        ],
        [
          "text",
          " fails. It is not general"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "interface failover, local-media fallback, or recovery from every partial HTTP"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "download failure."
        ]
