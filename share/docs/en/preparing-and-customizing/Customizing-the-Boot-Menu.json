    [
      "heading",
      1,
      "customizing-the-boot-menu",
      [
        [
          "text",
          "Customizing the boot menu"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS boot menus provide convenient entries for common live boot modes. This guide explains how to select and edit those entries."
        ]
      ]
    ],
    [
      "heading",
      2,
      "overview",
      [
        [
          "text",
          "Overview"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS images can use GRUB or Syslinux depending on firmware, image layout, and build. Their menu graphs, editing keys, language handling, and available entries are not necessarily identical. The bootloader ultimately passes a kernel command line to the same initrd; see "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Boot modes"
            ]
          ]
        ],
        [
          "text",
          " for the resulting source, persistence, RAM-copy, and media-dependency behavior."
        ]
      ]
    ],
    [
      "heading",
      2,
      "boot-menu-options",
      [
        [
          "text",
          "Boot Menu Options"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The supplied image commonly presents these semantic choices, although titles, availability, order, and default selection can vary by image:"
        ]
      ]
    ],
    [
      "table",
      [
        [
          "table_row",
          true,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Menu choice"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Typical initrd selector"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Purpose"
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Start MiniOS"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=resume"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Try the default compatible session and permit replacement creation under the documented conditions."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Start a new session"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=new"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Create an additional numbered persistent session while keeping existing sessions unchanged."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Choose a saved session"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchdir=ask"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Select an existing saved session interactively. Use "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Start a new session"
                    ]
                  ]
                ],
                [
                  "text",
                  " on empty storage."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Start without saving"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "no persistence selector"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Use a temporary writable layer in RAM."
                ]
              ]
            ]
          ]
        ],
        [
          "table_row",
          false,
          [
            [
              "table_cell",
              [
                [
                  "text",
                  "Run from RAM"
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram"
                    ]
                  ]
                ]
              ]
            ],
            [
              "table_cell",
              [
                [
                  "text",
                  "Copy the complete MiniOS data tree to RAM and try to detach the source."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "These are selectors, not guarantees that storage is writable, a session is compatible, RAM is sufficient, or source media has detached. See "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Boot modes"
            ]
          ]
        ],
        [
          "text",
          " for behavior and combinations, "
        ],
        [
          "link",
          "/reference/boot-process/Persistence-Internals.md",
          null,
          [
            [
              "text",
              "Initrd persistence"
            ]
          ]
        ],
        [
          "text",
          " for selector edge cases, and "
        ],
        [
          "link",
          "/maintenance-and-recovery/Performance.md",
          null,
          [
            [
              "text",
              "Performance optimization"
            ]
          ]
        ],
        [
          "text",
          " for RAM and I/O tradeoffs."
        ]
      ]
    ],
