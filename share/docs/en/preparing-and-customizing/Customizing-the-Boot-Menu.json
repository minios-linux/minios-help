      "heading",
      3,
      "common-boot-parameter-modifications",
      [
        [
          "text",
          "Common Boot Parameter Modifications"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "debug"
                    ]
                  ]
                ],
                [
                  "text",
                  " - Show detailed boot messages (useful for troubleshooting)"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "toram=trim"
                    ]
                  ]
                ],
                [
                  "text",
                  " - Copy the filtered module set and limited required data to RAM"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "perchsize=2000"
                    ]
                  ]
                ],
                [
                  "text",
                  " - Set session storage size to 2GB (adjust as needed)"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "locales=ru_RU.UTF-8"
                    ]
                  ]
                ],
                [
                  "text",
                  " - Request a specific language/locale"
                ]
              ]
            ]
          ]
        ]
      ]
