  "nodes": [
    [
      "heading",
      1,
      "packages-and-editions",
      [
        [
          "text",
          "Packages and editions"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS package contents are generated from conditional source lists. They vary"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "by distribution suite, architecture, init system, desktop environment, locale,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "kernel options, and repository availability. This page describes edition"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "inheritance and representative contents; it is not an exhaustive release"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "package table."
        ]
      ]
    ],
    [
      "heading",
      2,
      "edition-inheritance",
      [
        [
          "text",
          "Edition inheritance"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The public editions form an additive sequence:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Flux"
                    ]
                  ]
                ],
                [
                  "text",
                  " provides the common live system and the lightweight Flux environment."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Standard"
                    ]
                  ]
                ],
                [
                  "text",
                  " inherits the common package base and adds general administration, desktop, and MiniOS management tools."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Toolbox"
                    ]
                  ]
                ],
                [
                  "text",
                  " inherits Standard and adds recovery, diagnostics, storage, networking, and virtualization tools."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Ultra"
                    ]
                  ]
                ],
                [
                  "text",
                  " inherits Toolbox and adds broader workstation, media, office, and container software."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Conditional expressions can select alternatives or omit a package for a suite,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "architecture, environment, or build option. A package named below is therefore"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "representative of the current source lists, not a promise that the same Debian"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "binary package name exists in every MiniOS release."
        ]
      ]
    ],
    [
      "heading",
      2,
      "desktop-and-environment-scope",
      [
        [
          "text",
          "Desktop and environment scope"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Desktop packages come from the selected environment's ordered module chain."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "The Xfce, Fluxbox, LXQt, core, and debug environments do not have identical"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "module or package sets. The examples below use the current Xfce lists unless a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "capability comes from the shared core list. A console or another desktop build"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "must be inspected independently."
        ]
      ]
    ],
    [
      "heading",
      2,
      "representative-contents",
      [
        [
          "text",
          "Representative contents"
        ]
      ]
    ],
    [
      "heading",
      3,
      "flux",
      [
        [
          "text",
          "Flux"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The common Flux composition includes MiniOS live configuration and image"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "tools, NetworkManager, SSH, keyboard and locale support, firmware selected for"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the target, and utilities for hardware inspection and common storage tasks."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Representative packages include "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-tools"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-image-compose"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-live-config"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "pciutils"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "usbutils"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "smartmontools"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "dosfstools"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ntfs-3g"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "btrfs-progs"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "xorriso"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "squashfs-tools"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "zstd"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "rfkill"
            ]
          ]
        ],
        [
          "text",
          ", and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "wpasupplicant"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The Flux desktop chain adds Fluxbox and the supporting tools selected by the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "source lists. It does not include the complete Xfce application and MiniOS GUI"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "set described under Standard."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The MiniOS utilities present in every edition, including Flux, are"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-tools"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-image-compose"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-live-config"
            ]
          ]
        ],
        [
          "text",
          ", the matching"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "systemd or SysV init integration, "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-live-config-doc"
            ]
          ]
        ],
        [
          "text",
          ", and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-welcome"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "heading",
      3,
      "standard",
      [
        [
          "text",
          "Standard"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Standard adds shared capabilities such as DNS support, additional compression"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "and filesystem tools, network filesystem clients, FUSE, partitioning, and ISO"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "creation. Representative packages include "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "dnsmasq-base"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ncdu"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsof"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "xfsprogs"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "exfatprogs"
            ]
          ]
        ],
        [
          "text",
          " or its suite-specific alternative, "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "cifs-utils"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "nfs-common"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "parted"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "7zip"
            ]
          ]
        ],
        [
          "text",
          ", and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "genisoimage"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "In Xfce, Standard and later editions add the current MiniOS graphical and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "administrative utilities: "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-configurator"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-installer"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-session-manager"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-kernel-manager"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-store"
            ]
          ]
        ],
        [
          "text",
          ","
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-store-gui"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-image-builder"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-module-manager"
            ]
          ]
        ],
        [
          "text",
          ", and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "driveutility"
            ]
          ]
        ],
        [
          "text",
          ". They also add LightDM, desktop audio and Bluetooth integration,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "screenshots, task management, notifications, and the Xfce terminal."
        ]
      ]
    ],
    [
      "heading",
      3,
      "toolbox",
      [
        [
          "text",
          "Toolbox"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Toolbox adds command-line storage, recovery, performance, network, and virtual"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "machine capabilities. Current examples include LVM and LUKS tools, Clonezilla,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Partclone, TestDisk, "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "gddrescue"
            ]
          ]
        ],
        [
          "text",
          ", ZFS tools when the build supports them, Nmap,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "iperf3, QEMU, libvirt, guest agents, fio, sysbench, and hardware reporting."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The Xfce application module adds representative tools such as GParted,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "GSmartControl, Guymager, Rescue and disk utilities, Wireshark, Remmina,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Virt Manager, VLC, KeePassXC, PDF Arranger, Codium, BleachBit, and graphical"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "encryption tools. Exact names are suite-dependent; for example, a source list"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "may use one of several package alternatives."
        ]
      ]
    ],
    [
      "heading",
      3,
      "ultra",
      [
        [
          "text",
          "Ultra"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Ultra retains the Toolbox set and adds container and workstation software."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Representative shared additions include Docker packages selected for the target"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "repository, Compose support, "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lazydocker"
            ]
          ]
        ],
        [
          "text",
          ", iSCSI tools, and user-namespace"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "utilities. The current Xfce application list adds LibreOffice, GIMP, Inkscape,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Blender, Audacity, OBS Studio, RawTherapee, Synaptic, and related desktop"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "integration packages."
        ]
      ]
    ],
    [
      "heading",
      2,
      "inspect-exact-release-contents",
      [
        [
          "text",
          "Inspect exact release contents"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The running system is authoritative for packages that were actually installed"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "in that release. List package names and versions with:"
        ]
      ]
    ],
    [
      "code_block",
      "dpkg-query -W -f='${binary:Package}\\t${Version}\\n' | sort",
      "bash",
      [
        [
          "syntax",
          "dpkg-query",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "-W",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "-f=",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          "'${binary:Package}\\t${Version}\\n'",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "|",
          "#D73A49",
          "#F97583"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "sort",
          "#6F42C1",
          "#B392F0"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Inspect the ordered modules composing the running root separately from the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "files selected for the next boot. MiniOS Module Manager presents these as"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Running now"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Next boot"
            ]
          ]
        ],
        [
          "text",
          ". From a shell, the runtime SquashFS mounts can"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "be listed with:"
        ]
      ]
    ],
    [
      "code_block",
      "findmnt -rn -t squashfs -o TARGET,SOURCE",
      "bash",
      [
        [
          "syntax",
          "findmnt",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "-rn",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
