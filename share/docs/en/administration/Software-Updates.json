    [
      "heading",
      1,
      "software-updates",
      [
        [
          "text",
          "Software updates"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS combines read-only SquashFS image modules with a writable runtime"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "overlay. An update method must match the layer being changed. Updating packages"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "inside a running session is not the same as replacing the modules on the MiniOS"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "medium."
        ]
      ]
    ],
    [
      "heading",
      2,
      "update-packages-with-apt",
      [
        [
          "text",
          "Update packages with APT"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "APT writes to the runtime overlay. Enable and use a persistent session before"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "updating if the changes must survive a reboot:"
        ]
      ]
    ],
    [
      "code_block",
      "sudo apt update\nsudo apt upgrade",
      "bash",
      [
        [
          "syntax",
          "sudo",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "apt",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "update",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          "\n",
          "#24292e",
          "#e1e4e8"
        ],
        [
          "syntax",
          "sudo",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "apt",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "upgrade",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Without persistence, package changes disappear at shutdown. With persistence,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "updated files and APT state remain in that session, but the underlying "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sb"
            ]
          ]
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "image modules are unchanged. A fresh session still uses the package versions in"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the image."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "APT is suitable for maintaining one persistent installation. Check available"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "space first because updated files are stored in addition to the compressed base"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "modules. MiniOS does not support in-place upgrades between releases. Do not"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "treat a Debian release upgrade as a MiniOS image upgrade; back up your data and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "use an image built for the target release instead."
        ]
      ]
    ],
    [
      "heading",
      2,
      "update-software-with-modules",
      [
        [
          "text",
          "Update software with modules"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "An "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sb"
            ]
          ]
        ],
        [
          "text",
          " module is read-only software loaded at boot. Modules are durable when"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "stored in the writable MiniOS "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "modules/"
            ]
          ]
        ],
        [
          "text",
          " directory or a durable persistence"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "module source. They do not require package changes to be saved in the session."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Inspect the next-boot module set before and after adding a module:"
        ]
      ]
    ],
    [
      "code_block",
      "sb next-boot\nsudo sb next-boot add 50-example.sb",
      "bash",
      [
        [
          "syntax",
          "sb",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
