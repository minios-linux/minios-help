          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "next-boot",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          "\n",
          "#24292e",
          "#e1e4e8"
        ],
        [
          "syntax",
          "sudo",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "sb",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "next-boot",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "add",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
