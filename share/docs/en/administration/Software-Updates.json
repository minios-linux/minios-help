          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Base modules and modules on read-only media cannot be removed by this command."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Build or obtain updated modules for the same architecture, distribution release,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "and lower module stack. Higher-numbered modules override lower layers, so an old"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "add-on module can also override files supplied by a newer base image."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "For locally packaged software, "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "apt2sb upgrade"
            ]
          ]
        ],
        [
          "text",
          " can create an update module. See"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/development/Creating-Modules.md",
          null,
          [
            [
              "text",
              "Creating modules"
            ]
          ]
        ],
        [
          "text",
          " for module build and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "dependency-level details."
        ]
      ]
    ],
    [
      "heading",
      2,
      "replace-image-modules",
      [
        [
          "text",
          "Replace image modules"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Official image updates replace files on the MiniOS medium; "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "apt upgrade"
            ]
          ]
        ],
        [
          "text",
          " does"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "not update them. Prefer replacing the complete base module set and matching boot"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "files from one MiniOS release, or reinstalling from the new image. Do not mix"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "core, desktop, application, firmware, or boot files from different releases"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "unless their compatibility is documented."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Before replacement:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Back up the MiniOS configuration, persistence data, user modules, and the"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "current base modules as described in "
                ],
                [
                  "link",
                  "/administration/Backup-Recovery.md",
                  null,
                  [
                    [
                      "text",
                      "Backup and"
                    ],
                    [
                      "text",
                      "\n"
                    ],
                    [
                      "text",
                      "recovery"
                    ]
                  ]
                ],
                [
                  "text",
                  "."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Record the active and next-boot module lists with "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "sb list"
                    ]
                  ]
                ],
                [
                  "text",
                  " and"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "sb next-boot"
                    ]
                  ]
                ],
                [
                  "text",
                  "."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Perform the replacement from another system or from a RAM-loaded boot so the"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "source files are not in use."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Keep the previous files until the new image boots and required hardware and"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "applications have been tested."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Preserve module basenames and ordering when a release instructs direct"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "replacement. A later source with the same basename replaces an earlier source"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "in the next-boot selection; differently named copies may both load and produce"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "an unintended layer order."
        ]
      ]
    ],
    [
      "heading",
      2,
      "update-the-kernel",
      [
        [
          "text",
          "Update the kernel"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The kernel is a coordinated set: the "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "01-kernel.sb"
            ]
          ]
        ],
        [
          "text",
          " driver module, kernel image,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "initramfs, and bootloader configuration must agree. Use MiniOS Kernel Manager or"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-kernel"
            ]
          ]
        ],
        [
          "text",
          " command instead of updating only a "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "linux-image"
            ]
          ]
        ],
        [
          "text",
          " package with"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "APT."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "List and package a repository kernel, then activate it for the next boot:"
        ]
      ]
    ],
