          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "50-example.sb",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "sb next-boot add"
            ]
          ]
        ],
        [
          "text",
          " validates and atomically publishes a new module, but it does"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "not overwrite an existing module with the same name. Remove a replaceable user"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "module first when an update intentionally keeps the same basename:"
        ]
      ]
    ],
    [
      "code_block",
      "sudo sb next-boot remove 50-example.sb\nsudo sb next-boot add 50-example.sb",
      "bash",
      [
        [
          "syntax",
          "sudo",
          "#6F42C1",
          "#B392F0"
        ],
        [
