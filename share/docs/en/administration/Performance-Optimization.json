        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Boot parameters can move startup work and live-system reads between RAM and the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "source device. See "
        ],
        [
          "link",
          "/configuration/Boot-Parameters.md",
          null,
          [
            [
              "text",
              "Boot parameters"
            ]
          ]
        ],
        [
          "text",
          " for the"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "complete reference."
        ]
      ]
    ],
    [
      "heading",
      3,
      "loading-the-system-into-ram-toram",
      [
        [
          "text",
          "Loading the System into RAM ("
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram"
            ]
          ]
        ],
        [
          "text",
          ")"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "toram"
            ]
          ]
        ],
        [
          "text",
          " can reduce runtime latency from a slow USB device or network-backed ISO,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "at the cost of a longer boot and substantially more occupied RAM. Bare "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram"
            ]
          ]
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "uses the full-copy path. "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram=trim"
            ]
          ]
        ],
        [
          "text",
          " usually consumes less RAM, but its narrower"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "copy can omit data or modules needed later."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Leave room for the writable layer, applications, caches, and zram rather than"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "sizing only for module files. More RAM assigned to the live copy means less is"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "available to the workload. Follow "
        ],
        [
          "link",
          "/configuration/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Boot modes"
            ]
          ]
        ],
        [
          "text",
          " for"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "copy durability and media-removal constraints."
        ]
      ]
    ],
    [
      "heading",
      3,
      "filtering-modules-load-and-noload",
      [
        [
          "text",
          "Filtering Modules ("
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "load"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "noload"
            ]
          ]
        ],
        [
          "text",
          ")"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Filtering can reduce copied data and mounted layers, particularly with"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toram=trim"
            ]
          ]
        ],
        [
          "text",
          ". The cost is a less capable system and a greater chance of boot or"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "runtime failure if a dependency is omitted. Verify the resulting module set;"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "filter syntax and protected-module limitations are defined in"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/configuration/Initrd-Module-Loading.md",
          null,
          [
            [
              "text",
              "Initrd module loading"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
