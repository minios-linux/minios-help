    [
      "heading",
      2,
      "persistence-optimization",
      [
        [
          "text",
          "Persistence Optimization"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Persistence moves writable-layer I/O from temporary RAM to storage or a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "container. Backend choice affects latency, compatibility, capacity management,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "and recovery complexity."
        ]
      ]
    ],
    [
      "heading",
      3,
      "persistence-modes-perchmode",
      [
        [
          "text",
          "Persistence Modes ("
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "perchmode"
            ]
          ]
        ],
        [
          "text",
          ")"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "span",
                      "code",
                      [
                        [
                          "text",
                          "native"
                        ]
                      ]
                    ],
                    [
                      "text",
                      ":"
                    ]
                  ]
                ],
                [
                  "text",
                  " Avoids a filesystem-in-a-file layer and is the simplest choice on a suitable POSIX filesystem, but is unavailable on filesystems that cannot preserve required Linux metadata."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "span",
                      "code",
                      [
                        [
                          "text",
                          "raw"
                        ]
                      ]
                    ],
                    [
                      "text",
                      ":"
                    ]
                  ]
                ],
                [
                  "text",
                  " Has predictable fixed capacity and conventional ext4 behavior, but reserves its file size and cannot grow beyond available backing storage."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "span",
                      "code",
                      [
                        [
                          "text",
                          "dynfilefs"
                        ]
                      ]
                    ],
                    [
                      "text",
                      ":"
                    ]
                  ]
                ],
                [
                  "text",
                  " Expands on demand and supports otherwise unsuitable media, with additional mapping and recovery complexity."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "span",
                      "code",
                      [
                        [
                          "text",
                          "luks"
                        ]
                      ]
                    ],
                    [
                      "text",
                      ":"
                    ]
                  ]
                ],
                [
                  "text",
                  " Adds confidentiality at the cost of unlock work and encryption overhead."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "span",
                      "code",
                      [
                        [
                          "text",
                          "squashfs"
                        ]
                      ]
                    ],
                    [
                      "text",
                      ":"
                    ]
                  ]
                ],
                [
                  "text",
                  " Trades save-time compression and RAM extraction work for a compact snapshot; it is not a general low-latency writable backend."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Benchmark representative workloads on the actual device. Flash-controller,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "filesystem, USB bridge, and workload differences are more reliable than a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "universal ranking of persistence modes."
        ]
      ]
    ],
    [
      "heading",
      2,
      "zram-configuration",
      [
        [
          "text",
          "ZRAM Configuration"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Zram trades CPU time for compressed memory capacity and can avoid much slower"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "storage-backed swap. A larger zram device can absorb more inactive pages but"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "does not create physical RAM; incompressible workloads still consume memory."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "Compression algorithms trade throughput and CPU use against compression ratio,"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "and availability depends on the kernel. Start with the default and change"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "zramsize"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "zramcomp"
            ]
          ]
        ],
        [
          "text",
          ", or "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "nozram"
            ]
          ]
        ],
        [
          "text",
          " only for a measured workload; see"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/configuration/Boot-Parameters.md",
          null,
          [
            [
              "text",
              "Boot parameters"
            ]
          ]
        ],
        [
          "text",
          " for accepted values."
        ]
      ]
    ],
    [
