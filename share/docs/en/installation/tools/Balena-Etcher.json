    [
      "heading",
      2,
      "result-and-persistence",
      [
        [
          "text",
          "Result and persistence"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Etcher performs a raw image write: it copies the ISO layout to the whole target device. It does not create an ext4 partition in unused space, create a persistence session, or perform a MiniOS Installer deployment."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Persistence is enabled only when a boot entry or kernel command line requests it, and it still requires suitable writable storage. See "
        ],
        [
          "link",
          "/configuration/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Boot modes"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "link",
          "/configuration/Initrd-Persistence.md",
          null,
          [
            [
              "text",
              "Initrd persistence"
            ]
          ]
        ],
        [
          "text",
          " before relying on saved changes."
        ]
      ]
    ]
