          "text",
          "Using UNetbootin"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "UNetbootin is a cross-platform open-source utility that allows you to create bootable USB drives for various Linux distributions, including MiniOS."
        ]
      ]
    ],
