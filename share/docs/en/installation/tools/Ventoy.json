      "heading",
      1,
      "using-ventoy",
      [
        [
          "text",
          "Using Ventoy"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Ventoy is a popular tool for creating bootable USB drives that allows you to store multiple ISO files on one device and boot from any of them."
        ]
      ]
    ],
    [
      "heading",
      2,
      "important",
      [
        [
          "text",
          "Important"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Warning:"
            ]
          ]
        ],
        [
          "text",
          " Incorrect device selection will result in data loss! Always double-check the selected drive and backup important data."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Boot Mode Requirement:"
            ]
          ]
        ],
        [
          "text",
          " For MiniOS to work properly with Ventoy, you MUST select "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "GRUB2 mode"
            ]
          ]
        ],
        [
          "text",
          " when booting, or rename your ISO file with "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "VTGRUB2"
            ]
          ]
        ],
        [
          "text",
          " suffix (e.g., "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-standard-amd64_VTGRUB2.iso"
            ]
          ]
        ],
        [
          "text",
          ") to force GRUB2 mode automatically."
        ]
      ]
    ],
