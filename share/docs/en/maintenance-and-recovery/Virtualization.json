    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The current Debian kernel used by amd64 MiniOS also contains VirtualBox guest drivers, VMware graphics/network drivers, VirtIO, and Hyper-V drivers. Guest service packages add integration features; they are not what makes the basic VM boot possible."
        ]
      ]
    ],
    [
      "heading",
      3,
      "xfce-resolution-handling",
      [
        [
          "text",
          "Xfce resolution handling"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS provides "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "/usr/bin/minios-virtual-resolution"
            ]
          ]
        ],
        [
          "text",
          " through "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "minios-tools"
            ]
          ]
        ],
        [
          "text",
          " and starts it from the Xfce autostart session. It detects common virtual machines and uses XRandR only when active guest tools are not already managing the display."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Without an override, the requested resolution is "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "1280x800"
            ]
          ]
        ],
        [
          "text",
          ". Use "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "virtres=WIDTHxHEIGHT"
            ]
          ]
        ],
        [
          "text",
          " to request another resolution or "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "novirtres"
            ]
          ]
        ],
        [
          "text",
          " to disable this MiniOS adjustment."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "After a successful adjustment, the utility creates "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "~/.config/minios/virtual-resolution-configured"
            ]
          ]
        ],
        [
          "text",
          ". In a persistent session it will not apply the automatic adjustment again until that marker is removed."
        ]
      ]
    ],
