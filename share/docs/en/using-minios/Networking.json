    [
      "block",
      "paragraph",
      [
        [
          "span",
          "code",
          [
            [
              "text",
              "LIVE_NETWORK_METHOD"
            ]
          ]
        ],
        [
          "text",
          " accepts "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "dhcp"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "static"
            ]
          ]
        ],
        [
          "text",
          ", or "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "off"
            ]
          ]
        ],
        [
          "text",
          ". Unset and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "dhcp"
            ]
          ]
        ],
        [
          "text",
          " preserve the image's existing network setup rather than replacing normal NetworkManager behavior. "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "static"
            ]
          ]
        ],
        [
          "text",
          " writes a wired static IPv4 configuration; "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "off"
            ]
          ]
        ],
        [
          "text",
          " prepares the selected wired interface not to connect automatically. With "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "LIVE_NETWORK_BACKEND=\"auto\""
            ]
          ]
        ],
        [
          "text",
          ", MiniOS prefers NetworkManager and falls back to ifupdown when necessary. If no interface is specified, preconfiguration is applied only when exactly one eligible wired interface can be identified."
        ]
      ]
    ],
