    [
      "heading",
      2,
      "when-preconfiguration-applies",
      [
        [
          "text",
          "When preconfiguration applies"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The network component is a one-time "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          " setup step. After it has successfully run in a persistent session, ordinary network changes should be made with NetworkManager rather than by repeatedly editing the preconfiguration."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "If you intentionally need to apply changed MiniOS network preconfiguration to the same persistent session, remove its completion stamp and reboot:"
        ]
      ]
    ],
    [
      "code_block",
      "sudo rm -f /var/lib/live/config/network",
      "bash",
      [
        [
          "syntax",
          "sudo",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "rm",
          "#032F62",
          "#9ECBFF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "-f",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "/var/lib/live/config/network",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Do this only when you actually want "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          " to generate the wired policy again. Changing normal Wi-Fi or Ethernet connections does not require it."
        ]
      ]
    ],
    [
      "heading",
      2,
      "installer-preconfiguration",
      [
        [
          "text",
          "Installer preconfiguration"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The MiniOS Installer network step also performs preconfiguration for the target system. It supports wired DHCP or static IPv4 settings. Wi-Fi is left to NetworkManager after the installed system starts."
        ]
      ]
    ],
    [
      "heading",
      2,
      "early-boot-networking-is-different",
      [
        [
          "text",
          "Early-boot networking is different"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "NetworkManager configures the running MiniOS system. Networking used by the initramfs to obtain MiniOS itself is a separate mechanism."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "ip="
            ]
          ]
        ],
        [
          "text",
          " boot parameter, PXE downloads, and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "from=http://..."
            ]
          ]
        ],
        [
          "text",
          " therefore do not create NetworkManager profiles and should not be used as a way to configure the normal desktop network. See "
        ],
        [
          "link",
          "/reference/boot-process/Network-Boot.md",
          null,
          [
            [
              "text",
              "Network boot"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
