    [
      "heading",
      1,
      "networking",
      [
        [
          "text",
          "Networking"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS uses "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "NetworkManager"
            ]
          ]
        ],
        [
          "text",
          " for normal wired and Wi-Fi networking. MiniOS does not replace its connection model with a separate network configuration system."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "For ordinary use, open the network icon in the desktop panel. The standard NetworkManager tools are also available:"
        ]
      ]
    ],
    [
      "code_block",
      "nmtui\nnmcli",
      "bash",
      [
        [
          "syntax",
          "nmtui",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          "\n",
          "#24292e",
          "#e1e4e8"
        ],
        [
          "syntax",
          "nmcli",
          "#6F42C1",
          "#B392F0"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Use these tools for connecting to Wi-Fi, switching networks, configuring DHCP or static addresses, DNS, VPN connections, and other normal runtime networking. For their full behavior, use the NetworkManager documentation and manual pages."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "In a persistent MiniOS session, NetworkManager connection profiles are saved as part of that session. In "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Start without saving"
            ]
          ]
        ],
        [
          "text",
          ", changes disappear at shutdown."
        ]
      ]
    ],
    [
      "heading",
      2,
      "network-preconfiguration",
      [
        [
          "text",
          "Network preconfiguration"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS-specific network settings are primarily "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "preconfiguration"
            ]
          ]
        ],
        [
          "text",
          ". They are useful when an image, installer, or unattended deployment should start with a known wired configuration before the user opens NetworkManager."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The MiniOS "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "live-config"
            ]
          ]
        ],
        [
          "text",
          " network component supports wired IPv4 preconfiguration. It does not preconfigure Wi-Fi."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "A static example in "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "config.conf"
            ]
          ]
        ],
        [
          "text",
          " is:"
        ]
      ]
    ],
    [
      "code_block",
      "LIVE_NETWORK_METHOD=\"static\"\nLIVE_NETWORK_INTERFACE=\"enp1s0\"\nLIVE_NETWORK_ADDRESS=\"192.0.2.10\"\nLIVE_NETWORK_PREFIX=\"24\"\nLIVE_NETWORK_GATEWAY=\"192.0.2.1\"\nLIVE_NETWORK_DNS=\"1.1.1.1,9.9.9.9\"\nLIVE_NETWORK_BACKEND=\"auto\"",
      "bash",
