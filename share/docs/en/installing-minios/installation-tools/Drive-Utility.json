    [
      "heading",
      2,
      "format-a-device",
      [
        [
          "text",
          "Format a device"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Format"
            ]
          ]
        ],
        [
          "text",
          " creates a new single-filesystem layout on the selected device. Current filesystem choices are:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "FAT32"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "exFAT"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "NTFS"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "ext4"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "You can set a volume label. For ext4, Drive Utility can assign the root directory to the selected user and group."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Formatting is independent from writing a MiniOS ISO. Filesystem choices on this page describe Drive Utility's formatting operation; they do not alter the filesystem layout embedded in a raw ISO write."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "CLI example:"
        ]
      ]
    ],
    [
      "code_block",
      "sudo driveutility-format -d /dev/sdX -f ext4 -u 1000 -g 1000 MYDISK",
