    [
      "heading",
      2,
      "erase-a-device",
      [
        [
          "text",
          "Erase a device"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Wipe"
            ]
          ]
        ],
        [
          "text",
          " chooses among controller-native erase operations, discard/TRIM, and host-side overwrites according to the selected device and requested method."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Current backends include:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Secure erase"
                    ]
                  ]
                ],
                [
                  "text",
                  " — automatically selects a controller-supported method when available."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "ATA Secure Erase / Enhanced Secure Erase"
                    ]
                  ]
                ],
                [
                  "text",
                  " — issued through UDisks2 for supported SATA/ATA drives; frozen or unsupported devices are rejected."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "NVMe User Data Erase / Cryptographic Erase"
                    ]
                  ]
                ],
                [
                  "text",
                  " — uses NVMe Format NVM only when the controller reports the requested capability."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Discard / secure discard"
                    ]
                  ]
                ],
                [
                  "text",
                  " — uses "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "blkdiscard"
                    ]
                  ]
                ],
                [
                  "text",
                  " when the block device supports discard."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Zero overwrite"
                    ]
                  ]
                ],
                [
                  "text",
                  " — writes zeroes from the host."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Random overwrite"
                    ]
                  ]
                ],
                [
                  "text",
                  " — writes random data for the requested number of passes and can add a final zero pass."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Controller secure erase is not equivalent to repeatedly overwriting every logical block from the host. Availability depends on the device firmware, kernel interfaces, UDisks2, "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "nvme-cli"
            ]
          ]
        ],
        [
          "text",
          ", and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "blkdiscard"
            ]
          ]
        ],
        [
          "text",
          " support."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "For NVMe devices, Drive Utility preserves the active namespace LBA format, metadata setting, and protection-information setting when issuing Format NVM. It also refuses controller operations whose scope can affect multiple namespaces when the target cannot be proven safe as a single-namespace operation."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Examples:"
        ]
      ]
    ],
    [
      "code_block",
      "sudo driveutility-wipe -d /dev/nvme0n1 -m secure\nsudo driveutility-wipe -d /dev/sdX -m discard\nsudo driveutility-wipe -d /dev/sdX -p 3 -t random -z",
