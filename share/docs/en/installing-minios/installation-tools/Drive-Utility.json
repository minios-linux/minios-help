    [
      "block",
      "paragraph",
      [
        [
          "text",
          "The graphical application can also assign the resulting file to the desktop user so a root-created backup is immediately usable without a separate ownership fix."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "CLI example:"
        ]
      ]
    ],
