      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Launch Rufus"
                    ]
                  ]
                ],
                [
                  "text",
                  " as administrator."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Select the USB drive"
                    ]
                  ]
                ],
                [
                  "text",
                  " in the "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Device"
                    ]
                  ]
                ],
                [
                  "text",
                  " field."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Select the MiniOS ISO file"
                    ]
                  ]
                ],
                [
                  "text",
                  " with "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "SELECT"
                    ]
                  ]
                ],
                [
                  "text",
                  "."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "When Rufus asks how to write the hybrid image, keep "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "ISO Image mode"
                    ]
                  ]
                ],
                [
                  "text",
                  "."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Choose a suitable filesystem. FAT32 provides the broadest firmware compatibility; NTFS may limit direct UEFI boot on some systems."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Click "
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "START"
                    ]
                  ]
                ],
                [
                  "text",
                  " and confirm formatting of the selected device."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "ISO mode extracts the MiniOS files onto a normal filesystem. After installation, the remaining free space can still be used for ordinary files. This is usually the more convenient Rufus layout for a portable MiniOS drive."
        ]
      ]
    ],
    [
      "heading",
      3,
      "method-2-dd-mode",
      [
        [
          "text",
          "Method 2: DD mode"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Choose "
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "DD Image mode"
            ]
          ]
        ],
        [
          "text",
          " only when you specifically want an exact block-for-block copy of the published ISO. Rufus then reproduces the ISO layout on the whole device, similarly to "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "dd"
            ]
          ]
        ],
        [
          "text",
          ", Etcher, or Drive Utility write mode."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "DD mode is simple and predictable, but the device no longer has the normal single writable filesystem layout expected from a general-purpose flash drive."
        ]
      ]
    ],
    [
      "heading",
      2,
      "result-and-persistence",
      [
        [
          "text",
          "Result and persistence"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "ISO mode creates file-based MiniOS media on a normal writable filesystem. DD mode creates raw image media. Neither mode is a MiniOS Installer deployment, and neither automatically creates a persistent session."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS persistence can use suitable writable storage on a file-based Rufus installation when a persistent boot mode is selected. See "
        ],
        [
          "link",
          "/using-minios/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Boot modes"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "link",
          "/using-minios/Sessions-and-Persistence.md",
          null,
          [
            [
              "text",
              "Session management"
            ]
          ]
        ],
