    [
      "heading",
      1,
      "manual-file-based-installation",
      [
        [
          "text",
          "Manual file-based installation"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "This MiniOS installation method copies the system files to a normal filesystem and installs the bootloader there instead of writing the ISO block-for-block."
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "The remaining space on the filesystem stays available for ordinary files, so the device can continue to be used as a normal USB drive as well as a MiniOS boot device."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "This method is especially useful when you want direct access to the MiniOS files, normal data storage on the same partition, or a writable layout for persistent sessions. It uses the SYSLINUX bootloader and is intended for Windows and Linux."
        ]
      ]
    ],
    [
      "heading",
      2,
      "important",
      [
        [
          "text",
          "Important"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Warning:"
            ]
          ]
        ],
        [
          "text",
          " This procedure repartitions and formats the selected device. It is destructive to the whole device, not just the files currently visible on it. Back up important data and verify the exact device path, model, capacity, partition, and mount point before running "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          ", "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          ", or "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "bootinst"
            ]
          ]
        ],
        [
          "text",
          ". Disconnect other removable drives when possible."
        ]
      ]
    ],
