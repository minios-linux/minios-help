      [
        [
          "text",
          "Step 1: Prepare the drive"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Windows:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Open \"Disk Management\" ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "Win+R"
                    ]
                  ]
                ],
                [
                  "text",
                  ", then "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "diskmgmt.msc"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Verify the USB device by its disk number, model, and capacity. Do not continue if any detail is uncertain."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Right-click its volume and select \"Delete Volume\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Right-click on unallocated space and select \"New Simple Volume\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Choose file system: FAT32 (recommended) or NTFS"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Linux:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Set "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_DISK"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_PARTITION"
            ]
          ]
        ],
        [
          "text",
          " to exact paths only after matching the device model and capacity in "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsblk"
            ]
          ]
        ],
        [
          "text",
          ". The "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          " write replaces the partition table on the entire target disk. Run only one "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          " command for the filesystem you want."
        ]
      ]
    ],
