    [
      "heading",
      1,
      "verifying-downloads",
      [
        [
          "text",
          "Verifying downloads"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS releases are published on the official "
        ],
        [
          "link",
          "https://github.com/minios-linux/minios-live/releases",
          null,
          [
            [
              "text",
              "GitHub Releases page"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "link",
          "https://sourceforge.net/projects/minios-linux/",
          null,
          [
            [
              "text",
              "SourceForge"
            ]
          ]
        ],
        [
          "text",
          ". Each ISO has a matching file whose name ends in "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".iso.sha256"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "SHA-256 verification detects an incomplete or altered download. It does not prove who created the files. The release currently provides checksums, not cryptographic signature files, so this page does not describe signature verification."
        ]
      ]
    ],
    [
      "heading",
      2,
      "download-both-files",
      [
        [
          "text",
          "Download both files"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Download the ISO and its matching "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sha256"
            ]
          ]
        ],
        [
          "text",
          " file from the same release on GitHub or SourceForge. Keep both files in the same directory. Their base names must match, for example:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-trixie-xfce-standard-amd64-5.1.1.iso\nminios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Use the names from the release you downloaded in the commands below."
        ]
      ]
    ],
    [
      "heading",
      2,
      "linux",
      [
        [
          "text",
          "Linux"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Open a terminal in the download directory and run:"
        ]
      ]
    ],
    [
      "code_block",
      "sha256sum --check minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "bash",
      [
        [
          "syntax",
          "sha256sum",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "--check",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "A valid download reports the ISO name followed by "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "OK"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
