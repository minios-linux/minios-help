    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Use the core MiniOS CLI tools when you need a scriptable module workflow:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "sb"
                    ]
                  ]
                ],
                [
                  "text",
                  " inspects modules and manages the running and next-boot module sets."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "apt2sb"
                    ]
                  ]
                ],
                [
                  "text",
                  ", "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "script2sb"
                    ]
                  ]
                ],
                [
                  "text",
                  ", and "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "chroot2sb"
                    ]
                  ]
                ],
                [
                  "text",
                  " build modules in an isolated environment."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "dir2sb"
                    ]
                  ]
                ],
                [
                  "text",
                  " and "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "sb2dir"
                    ]
                  ]
                ],
                [
                  "text",
                  " convert between directory trees and "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      ".sb"
                    ]
                  ]
                ],
                [
                  "text",
                  " modules."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "savechanges"
                    ]
                  ]
                ],
                [
                  "text",
                  " captures eligible changes from a live writable session into a module."
