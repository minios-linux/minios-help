        [
          "text",
          "What are the default credentials?"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "An uncustomized live image uses "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "live"
            ]
          ]
        ],
        [
          "text",
          " / "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "evil"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "root"
            ]
          ]
        ],
        [
          "text",
          " / "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "toor"
            ]
          ]
        ],
        [
          "text",
          ", and may"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "allow automatic login and passwordless administration. Change these before"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "using an untrusted network; follow"
        ],
        [
          "text",
          "\n"
        ],
        [
