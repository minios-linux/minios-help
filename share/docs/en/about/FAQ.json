    [
      "heading",
      2,
      "why-did-my-changes-disappear-after-reboot",
      [
        [
          "text",
          "Why did my changes disappear after reboot?"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "You may have booted a fresh session, used media without persistence, or selected"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "a different session. Native, DynFileFS, raw, and LUKS sessions receive writes"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "while the system is running; they do not wait for a shutdown snapshot. Only"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "SquashFS persistence requires the RAM-backed changes to be rebuilt into"
        ],
        [
          "text",
          "\n"
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "changes.sb"
            ]
          ]
        ],
        [
          "text",
          ", so an interrupted shutdown or disabled save policy can leave its"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "latest changes unsaved. Check the running and active session as described in"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/configuration/Session-Management.md",
          null,
          [
            [
              "text",
              "Session management"
            ]
          ]
        ],
        [
          "text",
          " and"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/administration/Troubleshooting.md",
          null,
          [
            [
              "text",
              "Troubleshooting"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "heading",
      2,
      "are-luks-and-squashfs-the-same-kind-of-persistence",
      [
        [
          "text",
          "Are LUKS and SquashFS the same kind of persistence?"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "No. LUKS stores an encrypted writable ext4 session in a container. SquashFS is a"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "compressed snapshot that runs from a RAM-backed writable layer and must be"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "saved according to its policy. See"
        ],
        [
          "text",
          "\n"
        ],
        [
          "link",
          "/configuration/Session-Management.md",
          null,
          [
            [
              "text",
              "Session management"
            ]
          ]
        ],
        [
          "text",
          " and "
        ],
        [
          "link",
          "/administration/Security-Hardening.md",
          null,
          [
            [
              "text",
              "Security"
            ],
            [
              "text",
              "\n"
            ],
            [
              "text",
              "hardening"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "heading",
      2,
      "why-does-a-store-application-or-module-appear-only-after-reboot",
      [
        [
          "text",
          "Why does a Store application or module appear only after reboot?"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Module mode creates a read-only "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sb"
            ]
          ]
        ],
        [
          "text",
          " module for the next boot; it does not add"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "the application to the current module stack. Confirm its location and reboot as"
        ],
        [
          "text",
          "\n"
        ],
        [
          "text",
          "described in "
        ],
        [
          "link",
          "/administration/MiniOS-Store.md",
          null,
          [
