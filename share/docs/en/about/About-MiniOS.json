        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Available editions depend on the release and base distribution:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Flux"
                    ]
                  ]
                ],
                [
                  "text",
                  " uses the Flux environment and a reduced package set. It is suited"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "to systems where a smaller software selection is preferred."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Standard"
                    ]
                  ]
                ],
                [
                  "text",
                  " is the general-purpose edition. Current standard Debian and"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "Ubuntu builds use Xfce."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Toolbox"
                    ]
                  ]
                ],
                [
                  "text",
                  " adds system administration, storage, diagnostic, and recovery"
                ],
                [
                  "text",
                  "\n"
                ],
                [
                  "text",
                  "tools."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
