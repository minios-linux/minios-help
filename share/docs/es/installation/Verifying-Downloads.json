          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Compara exactamente los dos valores hexadecimales de 64 caracteres."
        ]
      ]
    ],
