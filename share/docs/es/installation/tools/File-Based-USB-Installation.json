          "Creación de una unidad USB booteable"
        ]
      ]
    ],
    [
      "heading",
      3,
      "paso-1-preparar-la-unidad",
      [
        [
          "text",
          "Paso 1: Preparar la unidad"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Windows:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Abre \"Administración de discos\" ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "Win+R"
                    ]
                  ]
                ],
                [
                  "text",
                  ", luego "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "diskmgmt.msc"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Verifica el dispositivo USB por su número de disco, modelo y capacidad. No continúes si tienes dudas sobre algún dato."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Haz clic derecho sobre su volumen y selecciona \"Eliminar volumen\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Haz clic derecho en el espacio no asignado y selecciona \"Nuevo volumen simple\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Elige sistema de archivos: FAT32 (recomendado) o NTFS"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Linux:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Asigna "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_DISK"
            ]
          ]
        ],
        [
          "text",
          " y "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_PARTITION"
            ]
          ]
        ],
        [
          "text",
          " solo a rutas exactas después de verificar el modelo y la capacidad del dispositivo en "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsblk"
            ]
          ]
        ],
        [
          "text",
          ". El comando "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          " sobrescribe la tabla de particiones en todo el disco de destino. Ejecuta solo un comando "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          " para el sistema de archivos que desees."
        ]
      ]
    ],
    [
      "code_block",
      "lsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL\nTARGET_DISK=/dev/sdX\nTARGET_PARTITION=/dev/sdX1\nlsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL \"$TARGET_DISK\"\n\n# Create new MBR partition table\nsudo fdisk \"$TARGET_DISK\"\n# In fdisk: o (new table), n (new partition), p (primary), a (bootable), w (write)\n\n# Verify the new partition, then create one filesystem\nlsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL \"$TARGET_DISK\"\nsudo mkfs.vfat -F 32 \"$TARGET_PARTITION\"  # For FAT32\n# Or: sudo mkfs.ext4 \"$TARGET_PARTITION\"  # For ext4",
