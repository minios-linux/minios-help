        [
          "text",
          "Tamaño de la unidad"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Consulta la "
        ],
        [
          "link",
          "/getting-started/Hardware-Compatibility.md",
          null,
          [
            [
              "text",
              "Guía de compatibilidad de hardware"
            ]
          ]
        ],
        [
          "text",
          " para conocer los requisitos del sistema y tamaños de unidad en detalle."
        ]
      ]
    ],
    [
      "heading",
      3,
      "requisitos-técnicos",
      [
        [
          "text",
          "Requisitos técnicos"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Sistemas de archivos"
                    ]
                  ]
                ],
                [
                  "text",
                  ": FAT32, NTFS, ext2/3/4, Btrfs"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Esquema de particionado"
                    ]
                  ]
                ],
                [
                  "text",
                  ": MBR"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Arranque EFI"
                    ]
                  ]
                ],
                [
                  "text",
                  ": Cuando se utilizan sistemas de archivos NTFS, exFAT o ext2/3/4, el arranque en modo EFI puede no estar disponible. Para soporte EFI, se recomienda FAT32."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
