    [
      "block",
      "paragraph",
      [
        [
          "text",
          "CondinAPT es una herramienta estándar para la instalación de paquetes en los módulos de MiniOS. Se integra en el proceso de construcción a través de la interfaz estándar de módulos."
        ]
      ]
    ],
