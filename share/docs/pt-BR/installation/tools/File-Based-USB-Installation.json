                  [
                    [
                      "text",
                      "Sistemas de arquivos"
                    ]
                  ]
                ],
                [
                  "text",
                  ": FAT32, NTFS, ext2/3/4, Btrfs"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Esquema de partição"
                    ]
                  ]
                ],
                [
                  "text",
                  ": MBR"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Inicialização EFI"
                    ]
                  ]
                ],
                [
                  "text",
                  ": Ao usar sistemas de arquivos NTFS, exFAT ou ext2/3/4, a inicialização em modo EFI pode não estar disponível. Para suporte EFI, recomenda-se FAT32."
                ]
              ]
            ]
          ]
        ]
