    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Se o seu pendrive MiniOS oferece suporte a vários idiomas:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "A primeira tela exibirá as opções de idioma"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Selecione o idioma de sua preferência"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "O menu de inicialização aparecerá no idioma selecionado"
