              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "A seleção também pode repassar as configurações de localidade para a próxima inicialização, mas não garante que todas as mensagens de boot ou dos aplicativos estejam traduzidas"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
