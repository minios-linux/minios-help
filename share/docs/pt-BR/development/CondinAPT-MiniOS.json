    [
      "block",
      "paragraph",
      [
        [
          "text",
          "O CondinAPT é uma ferramenta padrão para instalação de pacotes em módulos do MiniOS. Ele se integra ao processo de build por meio da interface padrão de módulos."
        ]
      ]
    ],
    [
      "block",
