      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "No script de instalação do módulo ("
            ],
            [
              "span",
              "code",
              [
                [
                  "text",
                  "install"
                ]
              ]
            ],
            [
              "text",
              "):"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
