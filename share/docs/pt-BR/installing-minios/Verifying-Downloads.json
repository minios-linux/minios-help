      "heading",
      1,
      "verificando-downloads",
      [
        [
          "text",
          "Verificando downloads"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "As versões do MiniOS são publicadas na página oficial de "
        ],
        [
          "link",
          "https://github.com/minios-linux/minios-live/releases",
          null,
          [
            [
              "text",
              "Releases do GitHub"
            ]
          ]
        ],
        [
          "text",
          " e no "
        ],
        [
          "link",
          "https://sourceforge.net/projects/minios-linux/",
          null,
          [
            [
              "text",
              "SourceForge"
            ]
          ]
        ],
        [
          "text",
          ". Cada ISO possui um arquivo correspondente cujo nome termina com "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".iso.sha256"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "A verificação SHA-256 detecta downloads incompletos ou alterados. Ela não comprova quem criou os arquivos. Atualmente, a versão fornece apenas checksums, e não arquivos de assinatura criptográfica, portanto, esta página não descreve a verificação de assinaturas."
        ]
      ]
    ],
    [
      "heading",
      2,
      "baixe-ambos-os-arquivos",
      [
        [
          "text",
          "Baixe ambos os arquivos"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Baixe a ISO e seu respectivo arquivo "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sha256"
            ]
          ]
        ],
        [
          "text",
          " da mesma versão no GitHub ou SourceForge. Mantenha ambos os arquivos no mesmo diretório. Os nomes base devem ser iguais, por exemplo:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-trixie-xfce-standard-amd64-5.1.1.iso\nminios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Use os nomes da versão que você baixou nos comandos abaixo."
        ]
      ]
    ],
    [
      "heading",
      2,
      "linux",
      [
        [
          "text",
          "Linux"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Abra um terminal no diretório de download e execute:"
        ]
      ]
    ],
    [
      "code_block",
      "sha256sum --check minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "bash",
      [
        [
          "syntax",
          "sha256sum",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "--check",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Um download válido exibe o nome da ISO seguido de "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "OK"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
    ],
