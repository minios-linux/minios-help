      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Abra o \"Gerenciamento de Disco\" ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "Win+R"
                    ]
                  ]
                ],
                [
                  "text",
                  ", depois "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "diskmgmt.msc"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Verifique o dispositivo USB pelo número do disco, modelo e capacidade. Não continue se houver qualquer dúvida."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Clique com o botão direito no volume e selecione \"Excluir Volume\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Clique com o botão direito no espaço não alocado e selecione \"Novo Volume Simples\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Escolha o sistema de arquivos: FAT32 (recomendado) ou NTFS"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Linux:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Defina "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_DISK"
            ]
          ]
        ],
        [
          "text",
          " e "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_PARTITION"
            ]
          ]
        ],
        [
          "text",
          " para os caminhos exatos somente após conferir o modelo e a capacidade do dispositivo em "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsblk"
            ]
          ]
        ],
        [
          "text",
          ". O comando "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          " sobrescreve a tabela de partições em todo o disco de destino. Execute apenas um comando "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          " para o sistema de arquivos desejado."
        ]
      ]
    ],
