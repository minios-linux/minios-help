      "heading",
      2,
      "3-persistenz-verstehen-bevor-sie-schreiben",
      [
        [
          "text",
          "3. Persistenz verstehen, bevor Sie schreiben"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Persistenz wird nicht durch jede Schreib- oder Startmethode erzeugt."
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Ein Rohabbild-Schreibvorgang mit "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "dd"
                    ]
                  ]
                ],
                [
                  "text",
                  ", Etcher oder einem ähnlichen Tool reproduziert das ISO. Dadurch wird jedoch keine persistente Sitzung eingerichtet."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Ventoy startet das ISO normalerweise als Datei. Die Persistenz von MiniOS muss separat eingerichtet werden."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Der MiniOS Installer kann eine Live-Installation erstellen und nativen, DynFileFS-, Raw- oder verschlüsselten LUKS-Sitzungsspeicher konfigurieren."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Ein frischer Start läuft absichtlich ohne Persistenz. Andere MiniOS Boot-Menüeinträge können Sitzungen fortsetzen, erstellen oder auswählen, wenn beschreibbarer Speicher verfügbar ist."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Eine native Installation ist ein konventionell installiertes System und verwendet Live-Session-Persistenz nicht auf die gleiche Weise."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Verwenden Sie "
        ],
        [
          "link",
          "/configuration/Boot-Modes.md",
          null,
          [
            [
              "text",
              "Boot-Modi"
            ]
          ]
        ],
        [
          "text",
          " als maßgebliche Anleitung für das für Nutzer sichtbare Verhalten beim Live-Start. Siehe "
        ],
        [
          "link",
          "/configuration/Session-Management.md",
          null,
          [
            [
              "text",
              "Sitzungsverwaltung"
            ]
          ]
        ],
        [
          "text",
          " für Speicheroptionen, "
        ],
        [
          "link",
          "/configuration/Initrd-Persistence.md",
          null,
          [
            [
              "text",
              "Initrd-Persistenz"
            ]
          ]
        ],
        [
          "text",
          " für den detaillierten Bootzeit-Vertrag und "
        ],
        [
          "link",
          "/configuration/Boot-Parameters.md",
          null,
          [
            [
              "text",
              "Boot-Parameter"
            ]
          ]
        ],
        [
          "text",
          ", bevor Sie Kernel-Optionen ändern. Erstellen Sie unabhängig vom Persistenzmodus ein Backup wichtiger Dateien."
        ]
      ]
    ],
    [
      "heading",
      2,
      "4-minios-starten",
      [
        [
          "text",
          "4. MiniOS starten"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Fahren Sie den Computer herunter und schließen Sie das vorbereitete Gerät an."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Öffnen Sie das Firmware-Boot-Menü und wählen Sie den UEFI- oder Legacy-Eintrag des Geräts aus."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Wählen Sie für einen ersten Hardware-Test eine frische Sitzung oder eine persistente Sitzung nur, wenn bereits eine konfiguriert wurde."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Überprüfen Sie, ob Grafik, Tastatur, Speicher und Netzwerk funktionieren, bevor Sie Änderungen an der Installation vornehmen, die nicht rückgängig gemacht werden können."
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Wenn das Gerät nicht aufgeführt ist oder der Desktop nicht startet, siehe "
        ],
        [
          "link",
          "/installation/Hardware-Compatibility.md",
          null,
          [
            [
              "text",
              "Hardware-Kompatibilität"
            ]
          ]
        ],
        [
          "text",
          " und "
        ],
        [
          "link",
          "/administration/Troubleshooting.md",
          null,
          [
            [
              "text",
              "Fehlerbehebung"
            ]
          ]
        ],
        [
          "text",
          ". Bei Problemen beim Auffinden der Live-Quelle siehe "
        ],
        [
          "link",
          "/configuration/Initrd-System-Discovery.md",
          null,
          [
            [
              "text",
              "Initrd-Systemerkennung"
            ]
          ]
        ],
        [
          "text",
          "."
        ]
      ]
