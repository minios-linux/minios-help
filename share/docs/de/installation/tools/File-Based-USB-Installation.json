    [
      "heading",
      3,
      "schritt-1-laufwerk-vorbereiten",
      [
        [
          "text",
          "Schritt 1: Laufwerk vorbereiten"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Windows:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": true,
        "start": 1
      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Öffnen Sie die \"Datenträgerverwaltung\" ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "Win+R"
                    ]
                  ]
                ],
                [
                  "text",
                  ", dann "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "diskmgmt.msc"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Überprüfen Sie das USB-Gerät anhand der Datenträgernummer, des Modells und der Kapazität. Fahren Sie nicht fort, wenn Sie sich bei einem Detail unsicher sind."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Klicken Sie mit der rechten Maustaste auf das Volume und wählen Sie \"Volume löschen\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Klicken Sie mit der rechten Maustaste auf den nicht zugeordneten Bereich und wählen Sie \"Neues einfaches Volume\""
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Wählen Sie das Dateisystem: FAT32 (empfohlen) oder NTFS"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Linux:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Setzen Sie "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_DISK"
            ]
          ]
        ],
        [
          "text",
          " und "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_PARTITION"
            ]
          ]
        ],
        [
          "text",
          " nur auf exakte Pfade, nachdem Sie das Gerätemodell und die Kapazität in "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsblk"
            ]
          ]
        ],
        [
          "text",
          " abgeglichen haben. Der "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          "-Schreibvorgang ersetzt die Partitionstabelle auf dem gesamten Zieldatenträger. Führen Sie nur einen "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          "-Befehl für das gewünschte Dateisystem aus."
        ]
      ]
    ],
    [
      "code_block",
      "lsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL\nTARGET_DISK=/dev/sdX\nTARGET_PARTITION=/dev/sdX1\nlsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL \"$TARGET_DISK\"\n\n# Create new MBR partition table\nsudo fdisk \"$TARGET_DISK\"\n# In fdisk: o (new table), n (new partition), p (primary), a (bootable), w (write)\n\n# Verify the new partition, then create one filesystem\nlsblk -o NAME,PATH,SIZE,FSTYPE,LABEL,MOUNTPOINTS,MODEL \"$TARGET_DISK\"\nsudo mkfs.vfat -F 32 \"$TARGET_PARTITION\"  # For FAT32\n# Or: sudo mkfs.ext4 \"$TARGET_PARTITION\"  # For ext4",
