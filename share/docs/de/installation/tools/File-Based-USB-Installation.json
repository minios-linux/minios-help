      },
      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Dateisysteme"
                    ]
                  ]
                ],
                [
                  "text",
                  ": FAT32, NTFS, ext2/3/4, Btrfs"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "Partitionsschema"
                    ]
                  ]
                ],
                [
                  "text",
                  ": MBR"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  ""
                ],
                [
                  "span",
                  "strong",
                  [
                    [
                      "text",
                      "EFI-Boot"
                    ]
                  ]
                ],
                [
                  "text",
                  ": Bei Verwendung von NTFS, exFAT oder ext2/3/4-Dateisystemen ist das Booten im EFI-Modus möglicherweise nicht verfügbar. Für EFI-Unterstützung wird FAT32 empfohlen."
                ]
              ]
            ]
          ]
        ]
      ]
