      "heading",
      1,
      "überprüfung-von-downloads",
      [
        [
          "text",
          "Überprüfung von Downloads"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "MiniOS-Versionen werden auf der offiziellen "
        ],
        [
          "link",
          "https://github.com/minios-linux/minios-live/releases",
          null,
          [
            [
              "text",
              "GitHub Releases-Seite"
            ]
          ]
        ],
        [
          "text",
          " veröffentlicht. Jede ISO-Veröffentlichung enthält eine passende Datei, deren Name auf "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".iso.sha256"
            ]
          ]
        ],
        [
          "text",
          " endet."
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Die SHA-256-Prüfung erkennt unvollständige oder veränderte Downloads. Sie beweist jedoch nicht, wer die Dateien erstellt hat. Derzeit werden nur Prüfsummen, aber keine kryptografischen Signaturdateien bereitgestellt, daher beschreibt diese Seite keine Signaturprüfung."
        ]
      ]
    ],
    [
      "heading",
      2,
      "beide-dateien-herunterladen",
      [
        [
          "text",
          "Beide Dateien herunterladen"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Laden Sie die ISO und die dazugehörige "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              ".sha256"
            ]
          ]
        ],
        [
          "text",
          "-Datei aus derselben GitHub-Veröffentlichung herunter. Bewahren Sie beide Dateien im selben Verzeichnis. Ihre Basisnamen müssen übereinstimmen, zum Beispiel:"
        ]
      ]
    ],
    [
      "code_block",
      "minios-trixie-xfce-standard-amd64-5.1.1.iso\nminios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "",
      []
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Verwenden Sie in den folgenden Befehlen die Namen aus der heruntergeladenen Veröffentlichung."
        ]
      ]
    ],
    [
      "heading",
      2,
      "linux",
      [
        [
          "text",
          "Linux"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Öffnen Sie ein Terminal im Download-Verzeichnis und führen Sie aus:"
        ]
      ]
    ],
    [
      "code_block",
      "sha256sum --check minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
      "bash",
      [
        [
          "syntax",
          "sha256sum",
          "#6F42C1",
          "#B392F0"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "--check",
          "#005CC5",
          "#79B8FF"
        ],
        [
          "syntax",
          " ",
          "#24292E",
          "#E1E4E8"
        ],
        [
          "syntax",
          "minios-trixie-xfce-standard-amd64-5.1.1.iso.sha256",
          "#032F62",
          "#9ECBFF"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Ein gültiger Download gibt den ISO-Namen gefolgt von "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "OK"
            ]
          ]
        ],
        [
          "text",
          " aus."
        ]
      ]
    ],
