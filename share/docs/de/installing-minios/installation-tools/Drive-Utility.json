      "heading",
      2,
      "gerät-formatieren",
      [
        [
          "text",
          "Gerät formatieren"
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Formatieren"
            ]
          ]
        ],
        [
          "text",
          " erstellt ein neues Ein-Dateisystem-Layout auf dem ausgewählten Gerät. Aktuell verfügbare Dateisysteme sind:"
        ]
      ]
    ],
    [
      "list",
      {
        "ordered": false,
        "start": 1
      },
      [
        [
          "item",
