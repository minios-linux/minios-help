      [
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "\"Datenträgerverwaltung\" öffnen ("
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "Win+R"
                    ]
                  ]
                ],
                [
                  "text",
                  ", dann "
                ],
                [
                  "span",
                  "code",
                  [
                    [
                      "text",
                      "diskmgmt.msc"
                    ]
                  ]
                ],
                [
                  "text",
                  ")"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "USB-Gerät anhand der Datenträgernummer, des Modells und der Kapazität überprüfen. Fahren Sie nicht fort, wenn Sie sich bei einem Detail unsicher sind."
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Mit der rechten Maustaste auf das Volume klicken und \"Volume löschen\" wählen"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Mit der rechten Maustaste auf den nicht zugeordneten Bereich klicken und \"Neues einfaches Volume\" wählen"
                ]
              ]
            ]
          ]
        ],
        [
          "item",
          null,
          [
            [
              "block",
              "paragraph",
              [
                [
                  "text",
                  "Dateisystem auswählen: FAT32 (empfohlen) oder NTFS"
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          ""
        ],
        [
          "span",
          "strong",
          [
            [
              "text",
              "Linux:"
            ]
          ]
        ],
        [
          "text",
          ""
        ]
      ]
    ],
    [
      "block",
      "paragraph",
      [
        [
          "text",
          "Setzen Sie "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_DISK"
            ]
          ]
        ],
        [
          "text",
          " und "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "TARGET_PARTITION"
            ]
          ]
        ],
        [
          "text",
          " erst auf die exakten Pfade, nachdem Sie Modell und Kapazität des Geräts in "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "lsblk"
            ]
          ]
        ],
        [
          "text",
          " abgeglichen haben. Das Schreiben mit "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "fdisk"
            ]
          ]
        ],
        [
          "text",
          " ersetzt die Partitionstabelle auf dem gesamten Zieldatenträger. Führen Sie nur einen "
        ],
        [
          "span",
          "code",
          [
            [
              "text",
              "mkfs"
            ]
          ]
        ],
        [
          "text",
          "-Befehl für das gewünschte Dateisystem aus."
        ]
      ]
    ],
