# Exclude VCS metadata and generated build/test artifacts.
tar-ignore=.git
tar-ignore=.pytest_cache
tar-ignore=__pycache__
tar-ignore=*.pyc
tar-ignore=*.pyo
tar-ignore=*.mo
tar-ignore=build
tar-ignore=share/.minios-help-docs-*
tar-ignore=share/.minios-help-old-*

# Exclude Debian build state and package artifacts.
tar-ignore=debian/.debhelper
tar-ignore=debian/debhelper-build-stamp
tar-ignore=debian/files
tar-ignore=debian/*.substvars
tar-ignore=debian/*.debhelper
tar-ignore=debian/*.log
tar-ignore=debian/minios-help
tar-ignore=debian/tmp
tar-ignore=*.build
tar-ignore=*.buildinfo
tar-ignore=*.changes
tar-ignore=*.deb
tar-ignore=*.dsc
tar-ignore=*.tar.*
